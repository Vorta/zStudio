{
  "name": "gamez-script",
  "displayName": "GameZ Script",
  "description": "GameZ Script highlighting, validation and navigation for RECOIL ZAD and ZRD sources, powered by zStudio.",
  "version": "0.9.8",
  "publisher": "Vorta",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Vorta/zStudio" },
  "engines": { "vscode": "^1.140.0" },
  "categories": ["Programming Languages", "Linters"],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "description": "Document-local highlighting and analysis work; project indexing requires workspace trust." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [{ "id": "gamez-script", "aliases": ["GameZ Script", "gamez-script"], "extensions": [".zad", ".zrd"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "gamez-script", "scopeName": "source.gamez", "path": "./syntaxes/gamez.tmLanguage.json" }],
    "commands": [
      { "command": "gamez.validateProject", "title": "GameZ Script: Validate Project" },
      { "command": "gamez.restartLanguageServer", "title": "GameZ Script: Restart Language Server" }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "test": "node test/grammar.cjs && node test/protocol.cjs",
    "test:host": "node test/host-runner.cjs",
    "package": "vsce package --target win32-x64 --no-dependencies --out ../../artifacts/gamez-script-0.9.8-win32-x64.vsix"
  },
  "dependencies": { "vscode-languageclient": "11.0.0" },
  "overrides": { "@azure/msal-node": "7.1.1" },
  "devDependencies": {
    "@types/node": "26.6.5", "@types/vscode": "1.140.0", "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0", "esbuild": "0.28.2", "typescript": "7.0.2",
    "vscode-textmate": "9.3.2", "vscode-oniguruma": "2.0.1"
  }
}
