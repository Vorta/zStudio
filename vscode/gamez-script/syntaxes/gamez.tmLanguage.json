{
  "name": "GameZ Script",
  "scopeName": "source.gamez",
  "patterns": [
    { "name": "comment.line.number-sign.gamez", "begin": "#", "end": "$" },
    { "name": "string.quoted.double.gamez", "begin": "\"", "end": "\"|$", "patterns": [
      { "name": "constant.character.escape.gamez", "match": "\\\\(?:[\\\\\"]|x[0-9A-Fa-f]{2})" },
      { "name": "invalid.illegal.escape.gamez", "match": "\\\\." }
    ] },
    { "name": "constant.numeric.float.raw.gamez", "match": "(?<![\\w.])f32:[0-9a-fA-F]{8}(?![\\w.])" },
    { "name": "constant.numeric.float.gamez", "match": "(?<![\\w.])[+-]?(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?![\\w.])" },
    { "name": "constant.numeric.integer.gamez", "match": "(?<![\\w.])[+-]?[0-9]+(?![\\w.])" },
    { "name": "constant.language.gamez", "match": "\\b(?:ON_CALL|ON_STARTUP|WEAPON_HIT|COLLIDE_HIT|WEAPON_OR_COLLIDE_HIT|ANIMATION_OFFSET|SEQUENCE_OFFSET|EVENT_OFFSET|ACTIVE|INACTIVE|ON|OFF|TRUE|FALSE|HIGH|MEDIUM|LOW|INPUT_NODE|GLOBAL|LOCAL)\\b" },
    { "name": "keyword.control.gamez", "match": "\\b(?:CALL_ANIMATION|CALL_SEQUENCE|STOP_SEQUENCE|STOP_ANIMATION|RESET_ANIMATION|INVALIDATE_ANIMATION|IF|ELSEIF|ELSE|ENDIF|LOOP|CALLBACK|WAIT_FOR_COMPLETION)\\b" },
    { "name": "entity.name.type.gamez", "match": "\\b(?:ANIMATION_DEFINITIONS|ANIMATION_LIST|ANIMATION_DEFINITION|SEQUENCE_DEFINITION|RESET_STATE|ACTIVATION_PREREQUISITE|PICKUP_DATA|BALLISTICS|EFFECTS|SETS)\\b" },
    { "name": "support.type.property-name.gamez", "match": "[A-Za-z_][A-Za-z0-9_.-]*(?=\\s*\\()" },
    { "name": "punctuation.section.parens.gamez", "match": "[()]" },
    { "name": "variable.other.gamez", "match": "[A-Za-z_][A-Za-z0-9_.-]*" }
  ]
}
