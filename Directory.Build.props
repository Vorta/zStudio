<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep the restore graph identical for ordinary builds and win-x64 publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Company>Vorta</Company>
    <Product>zStudio</Product>
    <Description>Advanced viewer and editor for Zipper Interactive's ZBD files</Description>
    <RepositoryUrl>https://github.com/Vorta/zStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.2.17</Version>
  </PropertyGroup>
</Project>
