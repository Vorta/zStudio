<UserControl x:Class="Recoil.Zbd.Desktop.AnimationEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recoil.Zbd.Desktop">
 <UserControl.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/>
  </Style>
  <Style x:Key="SectionResizeHandle" TargetType="Thumb">
   <Setter Property="Height" Value="10"/><Setter Property="Cursor" Value="SizeNS"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="ToolTip" Value="Drag to resize vertically · Up/Down when focused"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border x:Name="GripBackground" Background="Transparent">
     <Border x:Name="Grip" Height="2" Width="32" CornerRadius="1" Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Opacity="0.55"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/><Setter TargetName="GripBackground" Property="Background" Value="#18808080"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/><Setter TargetName="GripBackground" Property="Background" Value="#25808080"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <EventSetter Event="DragDelta" Handler="SectionResizeDelta"/><EventSetter Event="DragCompleted" Handler="SectionResizeCompleted"/><EventSetter Event="KeyDown" Handler="SectionResizeKeyDown"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel>
    <ToggleButton x:Name="SidebarToggle" DockPanel.Dock="Right" Content="Details" IsChecked="True" Margin="4,2,2,2" Padding="10,4" VerticalAlignment="Top" Checked="SidebarToggled" Unchecked="SidebarToggled" ToolTip="Show or hide animation details" AutomationProperties.Name="Animation details"/>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" GotKeyboardFocus="ToolbarFocus">
   <StackPanel x:Name="ViewOptionsRow" Orientation="Horizontal">
    <StackPanel.Resources>
     <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="MinWidth" Value="0"/></Style>
    </StackPanel.Resources>
    <Button x:Name="UndoButton" Style="{StaticResource TransportButton}" Click="UndoClick" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
     <Path Data="M6,3 L2,7 6,11 M2,7 H10 C16,7 16,15 10,15" Width="18" Height="18" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Button>
    <Button x:Name="RedoButton" Style="{StaticResource TransportButton}" Click="RedoClick" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
     <Path Data="M12,3 L16,7 12,11 M16,7 H8 C2,7 2,15 8,15" Width="18" Height="18" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Button>
    <Button x:Name="SaveAsButton" Style="{StaticResource TransportButton}" Click="SaveClick" ToolTip="Save As… (Ctrl+S) · save a new anim.zbd outside the source folder" AutomationProperties.Name="Save As">
     <Path Data="M15,8 V5 L12,2 H2 V16 H9 M5,2 V7 H11 V2 M5,16 V11 H9 M11,16 L12,12 16,8 18,10 14,14 Z M14,10 L16,12" Width="20" Height="18" StrokeThickness="1.3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Button>
    <ComboBox x:Name="Phase" SelectedIndex="0" Width="116" Margin="3" ToolTip="Preview runtime sequences or the separate cleanup sequence" SelectionChanged="PreviewOptionChanged"><ComboBoxItem Content="Runtime"/><ComboBoxItem Content="Reset / stop"/></ComboBox>
    <Button Content="Frame view" Click="FrameClick" ToolTip="Frame the animation's current pose"/>
     <ComboBox x:Name="Lod" Width="190" Margin="3" SelectionChanged="LodChanged" ToolTip="Detail level for each object. Objects with fewer variants keep their last available level." AutomationProperties.Name="Animation LOD"/>
     <CheckBox x:Name="ShowGrid" Content="Grid" IsChecked="True" Margin="8,5" VerticalAlignment="Center" Checked="GroundChanged" Unchecked="GroundChanged" ToolTip="Show the Y=0 grid and enable flat-ground debris collision. Uncheck to disable both."/>
     <Label Content="Height" Target="{Binding ElementName=PreviewHeight}" VerticalAlignment="Center" Padding="2,0,4,0"/>
     <local:ValueTextBox x:Name="PreviewHeight" Style="{StaticResource {x:Type TextBox}}" Text="0" Width="62" Margin="0,3,4,3" VerticalContentAlignment="Center" TextChanged="HeightChanged" LostFocus="HeightEditingFinished" KeyDown="HeightKeyDown" ToolTip="Raise the animation above the Y=0 grid, in game units (0–100000). Valid values apply as you type. Preview only." AutomationProperties.Name="Animation height"/>
     <CheckBox x:Name="ShowLevel" Content="Map" Margin="8,5" VerticalAlignment="Center" Checked="LevelChanged" Unchecked="LevelChanged"/>
     <ComboBox x:Name="Difficulty" Width="104" Margin="0,3,4,3" SelectionChanged="DifficultyChanged" ToolTip="Mission difficulty · shared with Whole world and remembered across launches" AutomationProperties.Name="Mission difficulty"/>
     <CheckBox x:Name="ShowHorizon" Content="Horizon" IsChecked="True" Margin="8,5" VerticalAlignment="Center" ToolTip="Move the horizon with the preview camera" Checked="LevelChanged" Unchecked="LevelChanged"/>
     <CheckBox x:Name="FollowCamera" Content="Follow camera" Margin="8,5" VerticalAlignment="Center" Checked="PresentationChanged" Unchecked="PresentationChanged" ToolTip="Follow the animation's camera position and orientation; current camera is identified in Status"/>
     <CheckBox x:Name="Lighting" Content="Effects" IsChecked="True" Margin="8,5" VerticalAlignment="Center" ToolTip="Approximate lights, fog and screen effects"/>
    </StackPanel>
   </ScrollViewer>
   </DockPanel>
  <Grid x:Name="EditorBody" Grid.Row="1" SizeChanged="EditorSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SidebarSplitterColumn" Width="6"/><ColumnDefinition x:Name="SidebarColumn" Width="360"/></Grid.ColumnDefinitions>
   <Grid x:Name="PlayerArea">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" x:Name="ViewportArea" ClipToBounds="True" SizeChanged="EditorSizeChanged">
   <ContentControl x:Name="ViewportHost"/>
   <Border x:Name="ScreenOverlay" IsHitTestVisible="False"/>
   <Canvas x:Name="WaveOverlay" IsHitTestVisible="False"/>
   <Border x:Name="LoadingPanel" Background="#CC1A1F26" Padding="14"><TextBlock x:Name="LoadingText" Text="Loading animation preview…" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
  </Grid>
  <StackPanel x:Name="PlayerTransport" Grid.Row="1" Margin="3,5,3,2" SizeChanged="EditorSizeChanged">
   <Grid x:Name="TransportRow" SizeChanged="TransportSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Click="PlayClick" ToolTip="Play (Space)" AutomationProperties.Name="Play">
      <Path x:Name="PlayIcon" Data="M4,2 L14,8 4,14 Z" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
     </Button>
     <Button x:Name="StopButton" Style="{StaticResource TransportButton}" Click="StopClick" ToolTip="Stop · return to frame 0" AutomationProperties.Name="Stop">
      <Path Data="M3,3 H13 V13 H3 Z" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
     </Button>
     <Button x:Name="PreviousFrameButton" Style="{StaticResource TransportButton}" Click="PreviousFrameClick" ToolTip="Previous frame (−1f)" AutomationProperties.Name="Previous frame">
      <Path Data="M2,2 H4 V14 H2 Z M13,2 L5,8 13,14 Z" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
     </Button>
     <Button x:Name="NextFrameButton" Style="{StaticResource TransportButton}" Click="NextFrameClick" ToolTip="Next frame (+1f)" AutomationProperties.Name="Next frame">
      <Path Data="M12,2 H14 V14 H12 Z M3,2 L11,8 3,14 Z" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
     </Button>
    </StackPanel>
    <Slider x:Name="SeekSlider" Grid.Column="1" MinWidth="0" Minimum="0" Maximum="1" SmallChange="0.0166666666666667" LargeChange="1" TickFrequency="0.0166666666666667" IsSnapToTickEnabled="True" Margin="6,0" VerticalAlignment="Center" ValueChanged="SeekChanged" ToolTip="Scrub animation time · 60 fps" AutomationProperties.Name="Animation position"/>
    <TextBlock x:Name="TimeLabel" Grid.Column="2" Margin="6,0,2,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Text="0 / … f"/>
   </Grid>
   <ScrollViewer Margin="0,3,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" GotKeyboardFocus="ToolbarFocus">
   <StackPanel Orientation="Horizontal">
    <ComboBox x:Name="Speed" Width="78" SelectedIndex="2" Margin="3" ToolTip="Playback speed"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox>
    <CheckBox x:Name="Loop" Content="Replay preview" Margin="5" VerticalAlignment="Center" ToolTip="Repeat the displayed range from frame 0"/>
    <CheckBox x:Name="Mute" Content="Mute" IsChecked="False" Margin="5" VerticalAlignment="Center" Checked="AudioChanged" Unchecked="AudioChanged"/>
    <Slider x:Name="Volume" Minimum="0" Maximum="1" Value="0.5" Width="60" Margin="4" VerticalAlignment="Center" ValueChanged="AudioChanged" ToolTip="Volume"/>
    <TextBlock x:Name="RangeLabel" Text="Calculating duration…" FontSize="11" Opacity="0.65" VerticalAlignment="Center" Margin="5"/>
   </StackPanel>
   </ScrollViewer>
  </StackPanel>
    <Grid x:Name="DispatchedEventsPanel" Grid.Row="2" Margin="3,4,3,2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="TraceGraphicRow" Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Content="Fit trace" Click="FitTraceClick" ToolTip="Show the full preview range in the event trace"/><TextBlock Text="Dispatched events" VerticalAlignment="Center" FontSize="12" Margin="2,0"/></DockPanel>
     <local:AnimationTimeline x:Name="Timeline" Grid.Row="1" Margin="0,3" ToolTip="Drag to seek · Ctrl+wheel to zoom trace"/>
     <TextBlock x:Name="TraceHint" Grid.Row="2" Text="Drag to seek · Ctrl+wheel to zoom trace" Margin="2,3,2,0" FontSize="10" Opacity="0.65" TextWrapping="Wrap"/>
    </Grid>
   </Grid>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" DragStarted="SidebarResizeStarted" DragCompleted="SidebarResized" ToolTip="Resize animation details"/>
   <Border x:Name="SidebarHost" Grid.Column="2" BorderBrush="#35808080" BorderThickness="1,0,0,0" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}" Padding="6,0,0,0">
    <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="SidebarWheel" PanningMode="VerticalOnly">
     <StackPanel Margin="0,0,4,0">
   <Expander x:Name="PreviewOptionsSection" Header="Preview options" Margin="0,0,0,6">
    <Grid x:Name="PreviewOptionsBody" Height="208" MinHeight="100" MaxHeight="1200">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,2" Focusable="False">
    <StackPanel>
    <TextBlock x:Name="MissionLayoutLabel" Text="Mission start" Margin="5" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" ToolTip="Surrounding actors keep their recovered starting poses. Only the selected animation and its children advance."/>
    <WrapPanel>
    <Button Content="Bind…" Click="BindClick" ToolTip="Choose the root scene node for this preview"/>
    <Button Content="GameZ…" Click="WorldClick" ToolTip="Choose a matching mission scene"/>
    </WrapPanel>
    <WrapPanel>
    <TextBlock Text="Seed" VerticalAlignment="Center" Margin="5,0"/><TextBox x:Name="Seed" Text="1" Width="47" Margin="3" LostFocus="SeedChanged" ToolTip="Deterministic random seed; Enter or leave the field to apply"/>
    <ComboBox x:Name="Condition" SelectedIndex="0" Width="145" Margin="3" SelectionChanged="PreviewOptionChanged" ToolTip="Preview-only condition override: evaluate engine conditions, force true, or force false"><ComboBoxItem Content="Engine conditions"/><ComboBoxItem Content="Force true"/><ComboBoxItem Content="Force false"/></ComboBox>
    </WrapPanel>
    <WrapPanel>
    <TextBlock Text="Preview range (s)" VerticalAlignment="Center" Margin="4,0"/><TextBox x:Name="EndTime" Text="1" Width="65" Margin="3" LostFocus="RangeChanged" ToolTip="Custom preview range, rounded up to a 60 Hz frame; up to 3600 seconds"/>
    <Button x:Name="AutoRangeButton" Content="Auto" Click="AutoRangeClick" ToolTip="Restore the calculated duration or suggested preview range"/>
    </WrapPanel>
    </StackPanel>
    </ScrollViewer>
     <Thumb Grid.Row="1" Style="{StaticResource SectionResizeHandle}" AutomationProperties.Name="Resize Preview options"/>
    </Grid>
   </Expander>

    <Expander x:Name="SequencesSection" Header="Sequences" IsExpanded="True" Margin="0,0,0,6">
     <Grid x:Name="SequencesBody" Height="184" MinHeight="100" MaxHeight="1200">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListBox x:Name="Sequences" Margin="8,0,8,0" SelectionChanged="SequenceSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="0"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Grid.Row="1" Margin="8,0,8,2"><Button Content="+" Click="AddSequenceClick" ToolTip="Add runtime sequence"/><Button Content="Copy" Click="CopySequenceClick" ToolTip="Duplicate selected sequence"/><Button Content="−" Click="DeleteSequenceClick" ToolTip="Delete selected runtime sequence"/></WrapPanel>
      <Thumb Grid.Row="2" Style="{StaticResource SectionResizeHandle}" AutomationProperties.Name="Resize Sequences"/>
     </Grid>
    </Expander>
    <Expander x:Name="EventsSection" Header="Events" IsExpanded="True" Margin="0,0,0,6">
     <Grid x:Name="EventsBody" Height="332" MinHeight="168" MaxHeight="1200">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="8,0,8,2">
      <TextBlock x:Name="EventsContext" FontSize="11" Opacity="0.7" Margin="3,2,3,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="+" Click="AddEventClick" ToolTip="Insert event after selection"/><ComboBox x:Name="NewEventType" DisplayMemberPath="Name" Margin="2" ToolTip="Event type to insert" HorizontalAlignment="Stretch"/></DockPanel>
      <StackPanel Orientation="Horizontal">
       <Button Content="Copy" Click="CopyEventClick" ToolTip="Duplicate event"/><Button Content="−" Click="DeleteEventClick" ToolTip="Delete event"/><Button Content="↑" Click="MoveEventUpClick" ToolTip="Move event earlier"/><Button Content="↓" Click="MoveEventDownClick" ToolTip="Move event later"/>
      </StackPanel>
     </StackPanel>
      <DataGrid x:Name="Events" Grid.Row="1" Margin="8,0,8,2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="EventSelected" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" GridLinesVisibility="None" HeadersVisibility="Column" FontSize="12" RowHeight="44" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="28"/>
        <DataGridTemplateColumn Header="Event / start clock" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Margin="3,3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock FontSize="11" Opacity="0.7"><Run Text="{Binding Mode}"/><Run Text=" · "/><Run Text="{Binding Threshold}"/><Run Text=" s"/></TextBlock></StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Thumb Grid.Row="2" Style="{StaticResource SectionResizeHandle}" AutomationProperties.Name="Resize Events"/>
     </Grid>
    </Expander>
    <Expander x:Name="StatusSection" Header="Status" Margin="0,0,0,6">
     <Grid x:Name="StatusBody" Height="240" MinHeight="80" MaxHeight="1200">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="Diagnostics" Margin="8,0,8,2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" BorderThickness="0"/>
      <Thumb Grid.Row="1" Style="{StaticResource SectionResizeHandle}" AutomationProperties.Name="Resize Status"/>
     </Grid>
    </Expander>
    <Expander x:Name="TraceSection" Header="Event trace" Margin="0,0,0,6">
     <Grid x:Name="TraceBody" Height="240" MinHeight="80" MaxHeight="1200">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="TraceText" Margin="8,0,8,2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" BorderThickness="0"/>
      <Thumb Grid.Row="1" Style="{StaticResource SectionResizeHandle}" AutomationProperties.Name="Resize Event trace"/>
     </Grid>
    </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
