<local:FieldEditor x:Class="zStudio.Desktop.AnimationEditor" x:Name="Editor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:zStudio.Desktop">
 <!-- A compiled animation's isolated preview (design/animation-redesign.md §19): its labelled view commands (the window moves them
      into the compiled command bar) and the 3D view. The transport, Structure, Timing, Inspector and Scenario are the window's
      Animation mode components; this control owns the preview's player, scene and sound. -->
 <Grid x:Name="EditorRoot"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel x:Name="ViewOptionsRow" VerticalAlignment="Center" AutomationProperties.Name="Preview commands">
   <ComboBox x:Name="Lod" Style="{StaticResource PreviewLodPicker}" SelectionChanged="LodChanged" VerticalAlignment="Center" ToolTip="Level of detail · LOD 0 is the highest detail of each object" AutomationProperties.Name="Animation LOD"/>
   <Grid x:Name="DifficultyGroup" VerticalAlignment="Center" Margin="2,0">
    <ComboBox x:Name="Difficulty" Style="{StaticResource PreviewDifficultyPicker}" Width="174" FontSize="13" Padding="76,0,8,0" SelectionChanged="DifficultyChanged" ToolTip="Mission difficulty: which mission actors and animation bindings the preview uses" AutomationProperties.Name="Mission difficulty"/>
    <TextBlock Text="Difficulty" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
   </Grid>
   <ComboBox x:Name="Mission" Visibility="Collapsed" DisplayMemberPath="Label" MinWidth="115" MaxWidth="220" VerticalAlignment="Center" SelectionChanged="MissionChanged" ToolTip="Authored MechWarrior 3 mission" AutomationProperties.Name="Animation mission"/>
   <Border Style="{StaticResource CommandGroup}" AutomationProperties.Name="Camera"><StackPanel Orientation="Horizontal"><TextBlock Text="Camera" Style="{StaticResource CommandGroupLabel}"/>
    <Button x:Name="FramePose" Style="{StaticResource CommandGroupButton}" Click="FrameClick" ToolTip="Frame — fit the current animation pose in view" AutomationProperties.Name="Frame current pose"><local:PreviewIcon Kind="Frame" Width="16" Height="16"/></Button>
    <ToggleButton x:Name="FollowCamera" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.FollowCamera,ElementName=Editor,Mode=TwoWay}" Checked="PresentationChanged" Unchecked="PresentationChanged" ToolTip="Follow camera — the view follows the animation's camera; navigating turns it off (Numpad 0)" AutomationProperties.Name="Follow camera"><local:PreviewIcon Kind="Camera" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
   </StackPanel></Border>
   <Border Style="{StaticResource CommandGroup}" AutomationProperties.Name="Display"><StackPanel Orientation="Horizontal"><TextBlock Text="Display" Style="{StaticResource CommandGroupLabel}"/>
    <ToggleButton x:Name="ShowLevel" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.Map,ElementName=Editor,Mode=TwoWay}" Checked="LevelChanged" Unchecked="LevelChanged" ToolTip="Map — the mission's map around the animation" AutomationProperties.Name="Map"><local:PreviewIcon Kind="Map" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
    <ToggleButton x:Name="ShowHorizon" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.Horizon,ElementName=Editor,Mode=TwoWay}" Checked="LevelChanged" Unchecked="LevelChanged" ToolTip="Horizon — the mission's horizon" AutomationProperties.Name="Horizon"><local:PreviewIcon Kind="Horizon" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
    <ToggleButton x:Name="Lighting" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.Effects,ElementName=Editor,Mode=TwoWay}" Checked="PresentationChanged" Unchecked="PresentationChanged" ToolTip="Effects — preview lighting and screen effects (approximations)" AutomationProperties.Name="Effects"><local:PreviewIcon Kind="Effects" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
    <ToggleButton x:Name="ShowFaceOrientation" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.FaceOrientation,ElementName=Editor,Mode=TwoWay}" Checked="FaceOrientationChanged" Unchecked="FaceOrientationChanged" ToolTip="Face orientation — blue front faces, red back faces, from triangle winding" AutomationProperties.Name="Face orientation"><local:PreviewIcon Kind="FaceOrientation" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
   </StackPanel></Border>
   <Border x:Name="GroundTools" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Ground"><StackPanel Orientation="Horizontal"><TextBlock Text="Ground" Style="{StaticResource CommandGroupLabel}"/>
    <ToggleButton x:Name="ShowGrid" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.Grid,ElementName=Editor,Mode=TwoWay}" Checked="GridChanged" Unchecked="GridChanged" ToolTip="Grid — the Y = 0 reference grid (ground collision is separate)" AutomationProperties.Name="Grid"><local:PreviewIcon Kind="Grid" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
    <ToggleButton x:Name="GroundCollision" Style="{StaticResource CommandToggle}" IsChecked="{Binding Options.Collision,ElementName=Editor,Mode=TwoWay}" Checked="GroundChanged" Unchecked="GroundChanged" ToolTip="Ground collision — collide with the preview's flat ground at Y = −Height (works with Grid hidden; not terrain)" AutomationProperties.Name="Ground collision"><local:PreviewIcon Kind="Collision" Width="16" Height="16" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
    <TextBlock Text="Height" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <local:ValueTextBox x:Name="PreviewHeight" Text="0" Width="56" Height="28" MinHeight="28" Padding="6,0" Margin="0,0,3,0" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="HeightChanged" LostKeyboardFocus="HeightLostKeyboardFocus" KeyDown="HeightKeyDown" ToolTip="Height: a preview-only world-Y offset, −999 to 999 game units (the Scenario's Height). Moves the animation, not the grid; valid values apply as you type." AutomationProperties.Name="Height"/>
   </StackPanel></Border>
  </WrapPanel>
  <Grid Grid.Row="1" x:Name="PlayerArea" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
   <Grid x:Name="ViewportArea" ClipToBounds="True">
    <ContentControl x:Name="ViewportHost"/>
    <Border x:Name="ScreenOverlay" IsHitTestVisible="False"/>
    <Canvas x:Name="WaveOverlay" IsHitTestVisible="False"/>
    <Border x:Name="LoadingPanel" Background="#CC1A1F26" Padding="14"><TextBlock x:Name="LoadingText" Text="Loading animation preview…" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" TextAlignment="Center"/></Border>
   </Grid>
  </Grid>
 </Grid>
</local:FieldEditor>
