<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:zStudio.Desktop" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="PreviewControlSize">32</sys:Double>
  <sys:Double x:Key="PreviewIconSize">16</sys:Double>
  <local:PreviewToggleTooltip x:Key="PreviewToggleTooltip"/>
  <local:ShortLodLabel x:Key="ShortLodLabel"/>
  <DataTemplate x:Key="LodShortTemplate"><TextBlock Text="{Binding Converter={StaticResource ShortLodLabel}}"/></DataTemplate>
  <DataTemplate x:Key="LodFullTemplate"><TextBlock Text="{Binding}"/></DataTemplate>
  <local:LodItemTemplateSelector x:Key="LodItemTemplateSelector"/>
  <!-- Fluent's overlay scrollbar must not cover inspection actions. Keep the native ScrollViewer parts; while the
       content overflows, the scrollbar takes its own column after a gap. Without it, the content keeps a 6 px right
       margin, which with the card's padding matches the left. -->
  <ControlTemplate x:Key="InspectionScrollTemplate" TargetType="ScrollViewer">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0,0,6,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
      <Border x:Name="ScrollGutter" Grid.Column="1" Visibility="Collapsed" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}">
        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
        <Setter TargetName="ScrollGutter" Property="Visibility" Value="Visible"/>
        <Setter TargetName="ScrollGutter" Property="Margin" Value="4,0,0,0"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- Outliner content scrolls and clips before the scrollbar, including wide, deeply indented rows. -->
  <ControlTemplate x:Key="OutlinerScrollTemplate" TargetType="ScrollViewer">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" ClipToBounds="True"/>
      <Border x:Name="VerticalGutter" Grid.Column="1" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Margin="4,0,0,0" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}">
        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}"/>
      </Border>
      <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Height="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}"/>
    </Grid>
  </ControlTemplate>
  <Style x:Key="OutlinerScrollStyle" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
    <Setter Property="Template" Value="{StaticResource OutlinerScrollTemplate}"/>
  </Style>
  <Style TargetType="local:PreviewIcon"><Setter Property="Width" Value="{DynamicResource PreviewIconSize}"/><Setter Property="Height" Value="{DynamicResource PreviewIconSize}"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style x:Key="PreviewIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
   <Setter Property="Width" Value="{DynamicResource PreviewControlSize}"/><Setter Property="Height" Value="{DynamicResource PreviewControlSize}"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PreviewIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
   <Setter Property="Width" Value="{DynamicResource PreviewControlSize}"/><Setter Property="Height" Value="{DynamicResource PreviewControlSize}"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource PreviewToggleTooltip}"><Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource Self}"/><Binding Path="IsChecked" RelativeSource="{RelativeSource Self}"/><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/></MultiBinding></Setter.Value></Setter>
  </Style>
  <Style x:Key="PreviewLodPicker" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
   <Setter Property="Width" Value="102"/><Setter Property="Height" Value="{DynamicResource PreviewControlSize}"/>
   <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="ItemTemplateSelector" Value="{StaticResource LodItemTemplateSelector}"/>
  </Style>
  <Style x:Key="PreviewDifficultyPicker" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
   <Setter Property="Width" Value="104"/><Setter Property="Height" Value="{DynamicResource PreviewControlSize}"/>
   <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- The selected-object card: subtle icon buttons, a red-hover close, a segmented gizmo mode and section headers. -->
  <Style x:Key="CardIconButton" TargetType="Button">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="0"/><Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardCloseButton" TargetType="Button" BasedOn="{StaticResource CardIconButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A82518"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardSegmentToggle" TargetType="ToggleButton">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
   <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardSectionHeader" TargetType="ToggleButton">
   <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The source map editor: panes, the grouped command bar and viewport chips. -->
  <Style x:Key="SourcePane" TargetType="Border">
   <Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="CommandGroup" TargetType="Border">
   <Setter Property="CornerRadius" Value="7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,2,3,2"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CommandGroupLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
  </Style>
  <Style x:Key="CommandSeparator" TargetType="Border">
   <Setter Property="Width" Value="1"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
  </Style>
  <!-- A command: transparent until hovered; a toggled one takes the accent fill with dark icons. -->
  <!-- An expander that stays open: its header above its content, with no toggle (the source map's Diagnostics). -->
  <Style x:Key="FixedExpander" TargetType="Expander">
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <DockPanel><ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="12,8,12,6"/><ContentPresenter/></DockPanel>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CommandButton" TargetType="ButtonBase">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <!-- An icon's name shows as soon as it is pointed at. -->
   <Setter Property="ToolTipService.InitialShowDelay" Value="0"/><Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></Trigger>
     <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="local:CommandState.IsOn" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/><Setter TargetName="Chrome" Property="Background" Value="Transparent"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A whole-row link (a card's animation link): a command whose content keeps its alignment, left by default. -->
  <Style x:Key="RowLinkButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
   <Setter Property="Width" Value="NaN"/><Setter Property="Height" Value="30"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CommandToggle" TargetType="ToggleButton" BasedOn="{StaticResource CommandButton}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/></Style>
  <Style x:Key="CommandGroupButton" TargetType="Button" BasedOn="{StaticResource CommandButton}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/></Style>
  <!-- A segment of a two-way switch (Paint | Erase): accent with dark text when chosen. -->
  <Style x:Key="ZoneSegment" TargetType="RadioButton">
   <Setter Property="Height" Value="22"/><Setter Property="Padding" Value="7,0,9,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A segment of Animation mode's switches (Structure | Timing | Split, the scenario's choices): the chosen one raised. -->
  <Style x:Key="SegmentOption" TargetType="ToggleButton">
   <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A tab of Animation mode's right pane (Inspector | Scenario): a pivot whose chosen tab is SemiBold over a 3×16 accent bar. -->
  <Style x:Key="PaneTab" TargetType="ToggleButton">
   <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="2,0"/><Setter Property="Margin" Value="0,0,18,0"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid Background="{TemplateBinding Background}">
     <Border x:Name="Focus" BorderThickness="1" CornerRadius="4" BorderBrush="Transparent" Margin="-4,4"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     <Border x:Name="Bar" Width="16" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Background="Transparent"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The command bar's scenario summary: a 28-high pill with an accent dot when the scenario differs from the defaults. -->
  <Style x:Key="ScenarioChip" TargetType="Button">
   <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="11,0,13,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="6,0,0,0"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A chip floating over the 3D view: the theme background at 80% under a hairline border. -->
  <Style TargetType="local:ViewportChip">
   <Setter Property="Padding" Value="10,0,12,0"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:ViewportChip">
    <Grid>
     <Border CornerRadius="6" Opacity="0.8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
     <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A pane toggle in the status bar: a small bar that takes the accent while its pane shows. -->
  <Style x:Key="StatusPaneToggle" TargetType="ToggleButton">
   <Setter Property="Height" Value="24"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="1,0"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal"><Border x:Name="Bar" Width="3" Height="12" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource TextFillColorDisabledBrush}"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The World tree's keyboard focus: Fluent's two-tone ring, drawn inside a row's button (Frame and the eye touch) or its row. -->
  <Style x:Key="OutlinerFocusRing">
   <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" SnapsToDevicePixels="True"><Border BorderThickness="1" CornerRadius="2" BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OutlinerSegmentFocusRing">
   <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderThickness="2" CornerRadius="3" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" SnapsToDevicePixels="True"><Border BorderThickness="1" CornerRadius="1" BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A row's hide-in-view eye: shown while the row is pointed at or the object is hidden. It takes focus only from the keyboard
       (Left/Right), showing its tooltip at once. -->
  <Style x:Key="OutlinerEye" TargetType="Button" BasedOn="{StaticResource CommandButton}"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OutlinerFocusRing}"/><Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/></Style>
  <!-- A segment of a World tree section's Objects | Polygons switch. -->
  <Style x:Key="OutlinerSegment" TargetType="Button" BasedOn="{StaticResource CommandButton}"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="20"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OutlinerSegmentFocusRing}"/><Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/></Style>
</ResourceDictionary>
