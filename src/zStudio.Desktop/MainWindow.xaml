<Window x:Class="Recoil.Zbd.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recoil.Zbd.Desktop"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="zStudio" Icon="/Recoil.Zbd.Studio;component/Assets/studio.ico" Width="1560" Height="940" MinWidth="1080" MinHeight="650"
 Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
 <Window.Resources>
  <SolidColorBrush x:Key="AssetIconBrush" Color="#3C91D4"/>
  <SolidColorBrush x:Key="CaptionHoverBrush" Color="#20808080"/><SolidColorBrush x:Key="CaptionPressedBrush" Color="#40808080"/>
  <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
   <DockPanel ToolTip="{Binding ToolTip}" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Document}" Click="CloseFileClick" Visibility="{Binding IsOpen,Converter={StaticResource BoolVisibility}}" Padding="5,0" Margin="6,0,1,0" MinWidth="24" MinHeight="24" ToolTip="Close file" AutomationProperties.Name="Close file"/>
    <TextBlock x:Name="OpenFileMarker" DockPanel.Dock="Left" Text="●" FontSize="8" Width="6" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Hidden" Foreground="{StaticResource AssetIconBrush}"/>
    <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <Viewbox x:Name="FolderGlyph" Visibility="Collapsed">
      <Canvas Width="20" Height="20">
       <Path Data="M2,5 Q2,3.5 3.5,3.5 H7 L9,5.5 H16.5 Q18,5.5 18,7 V15 Q18,16.5 16.5,16.5 H3.5 Q2,16.5 2,15 Z" Fill="#2C73AC" Stroke="#225780" StrokeThickness="0.8"/>
       <Path x:Name="FolderFront" Data="M2,8 H18 V15 Q18,16.5 16.5,16.5 H3.5 Q2,16.5 2,15 Z" Fill="{StaticResource AssetIconBrush}" Stroke="#2B6794" StrokeThickness="0.8"/>
      </Canvas>
     </Viewbox>
     <TextBlock x:Name="FileGlyph" Text="{Binding FileIcon}" Foreground="{StaticResource AssetIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="FileName" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding File}" Value="{x:Null}">
     <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible"/>
     <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed"/>
     <Setter TargetName="OpenFileMarker" Property="Visibility" Value="Collapsed"/>
    </DataTrigger>
   <DataTrigger Binding="{Binding IsExpanded,RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
     <Setter TargetName="FolderFront" Property="Data" Value="M5,8 H18 Q19,8 18.6,9.2 L16.5,15.5 Q16.2,16.5 15,16.5 H2.5 L4,9 Q4.2,8 5,8 Z"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter TargetName="FileName" Property="FontWeight" Value="SemiBold"/><Setter TargetName="OpenFileMarker" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="FileName" Property="TextDecorations" Value="Underline"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:InspectorNode}" ItemsSource="{Binding Children}">
   <TextBlock Text="{Binding Label}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis"/>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:SceneTreeItem}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}"/></HierarchicalDataTemplate>
  <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}"><Setter Property="BorderThickness" Value="0"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style x:Key="CaptionButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
   <Setter Property="Width" Value="46"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CaptionHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CaptionPressedBrush}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TitleCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="1,0"/><Setter Property="Focusable" Value="True"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
  </Style>
  <ControlTemplate x:Key="TitleMenuTemplate" TargetType="MenuItem">
   <Grid>
    <Border x:Name="HeaderSurface" Margin="3,4" Padding="8,0" CornerRadius="4" Background="{TemplateBinding Background}">
     <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderSurface}" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
     <Border Padding="0,3" BorderThickness="1" CornerRadius="8" Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
      <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/></Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
 </Window.Resources>
 <Grid>
 <DockPanel x:Name="Shell">
  <Grid x:Name="TitleArea" DockPanel.Dock="Top" Height="42" MinHeight="42" Background="{DynamicResource ApplicationBackgroundBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0"><Image Source="/Recoil.Zbd.Studio;component/Assets/studio.ico" Width="20" Height="20"/><TextBlock x:Name="ApplicationTitle" Text="zStudio" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
   <Menu x:Name="AppMenu" Grid.Column="1" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Menu.ItemContainerStyle>
     <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Height" Value="42"/>
      <!-- Fluent selects templates in Role triggers, which override ordinary setters.
           Override those triggers so the compact title row retains full text height. -->
      <Style.Triggers>
       <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Template" Value="{StaticResource TitleMenuTemplate}"/></Trigger>
       <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Template" Value="{StaticResource TitleMenuTemplate}"/></Trigger>
      </Style.Triggers>
     </Style>
    </Menu.ItemContainerStyle>
   <MenuItem Header="_File"><MenuItem Header="_Open folder…" InputGestureText="Ctrl+O" Click="OpenFolderClick"/><MenuItem Header="Open _file…" Click="OpenFileClick"/><MenuItem x:Name="RecentMenu" Header="Recent folders"/><Separator/><MenuItem x:Name="ExportSelectedMenu" Header="Export _selected…" InputGestureText="Ctrl+E" Click="ExportSelectedClick"/><MenuItem x:Name="ExportAllMenu" Header="Export all assets in file…" Click="ExportAllClick"/><MenuItem x:Name="ExportJsonMenu" Header="Export selected as JSON…" Click="ExportJsonClick"/><MenuItem x:Name="CopyEventJsonMenu" Header="Copy selected event JSON" Click="CopyEventJsonClick"/><Separator/>
    <MenuItem x:Name="SaveMenu" Header="_Save" InputGestureText="Ctrl+S" Click="SaveCurrentClick"/><MenuItem x:Name="SaveAsMenu" Header="Save _as…" InputGestureText="Ctrl+Shift+S" Click="SaveCurrentAsClick"/>
    <MenuItem x:Name="BackupOnSave" Header="Create backup on Save" IsCheckable="True" Click="BackupOnSaveChanged" ToolTip="Keep a uniquely named .bak when saving pickup archives. Animation Save As always preserves its source."/>
    <Separator/><MenuItem x:Name="CloseDocumentMenu" Header="_Close file" InputGestureText="Ctrl+W" Click="CloseCurrentClick"/><MenuItem Header="E_xit" Click="ExitClick"/></MenuItem>
   <MenuItem Header="_Edit" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><MenuItem x:Name="UndoMenu" Header="Undo edit" InputGestureText="Ctrl+Z" Click="UndoAnimationClick"/><MenuItem x:Name="RedoMenu" Header="Redo edit" InputGestureText="Ctrl+Y" Click="RedoAnimationClick"/></MenuItem><MenuItem Header="_View"><MenuItem x:Name="PropertiesMenu" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" Header="_Properties…" InputGestureText="Alt+Enter" Click="PropertiesClick"/><Separator/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="InspectorVisibilityMenu" Header="Inspector" IsCheckable="True" IsChecked="True" Click="InspectorVisibilityClick"/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="ToolsVisibilityMenu" Header="Bottom tools" IsCheckable="True" IsChecked="False" Click="DiagnosticsClick"/><Separator Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"/><MenuItem Header="_Theme"><MenuItem Header="System" Click="ThemeClick"/><MenuItem Header="Light" Click="ThemeClick"/><MenuItem Header="Dark" Click="ThemeClick"/></MenuItem><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" Header="Workspace preset"><MenuItem Header="Inspect" Click="PresetClick"/><MenuItem Header="Edit" Click="PresetClick"/><MenuItem Header="Debug" Click="PresetClick"/><MenuItem Header="Focus preview" Click="PresetClick"/></MenuItem><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" Header="Density"><MenuItem Header="Compact" Click="DensityClick"/><MenuItem Header="Comfortable" Click="DensityClick"/></MenuItem><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="NavigatorVisibilityMenu" Header="Navigator" IsCheckable="True" IsChecked="True" Click="NavigatorClick"/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" Header="Reset layout" Click="ResetLayoutClick"/></MenuItem>
   <MenuItem x:Name="AnimationMenu" Header="_Animation" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><MenuItem Header="Play / pause" InputGestureText="Space" Click="AnimationPlayClick"/><MenuItem Header="Stop" Click="AnimationStopClick"/><MenuItem Header="Previous frame" Click="AnimationPreviousClick"/><MenuItem Header="Next frame" Click="AnimationNextClick"/><Separator/><MenuItem Tag="add-event" Header="Add event…" Click="AnimationAddEventClick"/><MenuItem Tag="add-sequence" Header="Add runtime sequence" Click="AnimationAddSequenceClick"/><MenuItem Tag="duplicate" Header="Duplicate selected record" Click="AnimationDuplicateClick"/><MenuItem Tag="delete" Header="Delete selected record" Click="AnimationDeleteClick"/><Separator/><MenuItem Header="Settings" Click="PreviewSetupClick"/></MenuItem>
   <MenuItem Header="_Tools"><MenuItem Header="MCP integration…" Click="McpIntegrationClick"/><Separator/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="ValidateMenu" Header="Validate source file on disk" Click="ValidateClick"/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="ReloadMenu" Header="Reload current file" InputGestureText="F5" Click="ReloadClick"/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="CancelOperationItem" Header="Cancel export or validation" InputGestureText="Esc" IsEnabled="False" Click="CancelClick"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="Controls and formats" Click="HelpClick"/><MenuItem Header="About zStudio" Click="AboutClick"/></MenuItem>
  </Menu>
   <Grid x:Name="DocumentCommands" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ActiveDocumentTitle" Text="{Binding SelectedDocument.Title}" ToolTip="{Binding SelectedDocument.Path}" MaxWidth="300" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
    <Button x:Name="DocumentUndo" Grid.Column="1" Style="{StaticResource TitleCommandButtonStyle}" Click="UndoAnimationClick" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A7;"/></Button>
    <Button x:Name="DocumentRedo" Grid.Column="2" Style="{StaticResource TitleCommandButtonStyle}" Click="RedoAnimationClick" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A6;"/></Button>
    <Button x:Name="DocumentSave" Grid.Column="3" Style="{StaticResource TitleCommandButtonStyle}" Click="SaveCurrentClick" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;"/></Button>
   </Grid>
   <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
    <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButtonStyle}" Click="CaptionMinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" ToolTip="Minimize"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE921;"/></Button>
    <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButtonStyle}" Click="CaptionMaximizeClick" AutomationProperties.Name="Maximize" ToolTip="Maximize"><TextBlock x:Name="CaptionMaximizeGlyph" FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE922;"/></Button>
    <Button x:Name="CaptionClose" Tag="Close" Style="{StaticResource CaptionButtonStyle}" Click="CaptionCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" ToolTip="Close"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE8BB;"/></Button>
   </StackPanel>
  </Grid>
  <StatusBar DockPanel.Dock="Bottom" Padding="0" MinHeight="0"><StatusBarItem Padding="4,0" MinHeight="0" HorizontalContentAlignment="Stretch" Width="{Binding ActualWidth,ElementName=Shell}"><DockPanel LastChildFill="True"><StackPanel x:Name="PaneButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><Button x:Name="NavigatorPaneButton" Padding="6,1" Margin="2,0" Content="Navigator" Tag="Layout" Click="NavigatorButtonClick"/><Button x:Name="InspectorPaneButton" Padding="6,1" Margin="2,0" Content="Inspector" Tag="Layout" Click="InspectorButtonClick"/><Button x:Name="ToolsPaneButton" Padding="6,1" Margin="2,0" Content="Tools" Tag="Layout" Click="ToolsButtonClick"/></StackPanel><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></StatusBarItem></StatusBar>
  <Grid x:Name="Workbench" SizeChanged="WorkbenchSizeChanged" Margin="6,0,6,4">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilesColumn" Width="294"/><ColumnDefinition x:Name="NavigatorSplitterColumn" Width="6"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition x:Name="PropertiesSplitterColumn" Width="6"/><ColumnDefinition x:Name="PropertiesColumn" Width="352"/></Grid.ColumnDefinitions>
   <Grid x:Name="NavigatorHost">

    <TabControl x:Name="NavigationTabs">
     <TabItem x:Name="FilesTab" Header="Files"><TreeView x:Name="FileTree" ItemsSource="{Binding Folders}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="FileDoubleClick" KeyDown="FileTreeKeyDown"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="True"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.ItemContainerStyle></TreeView></TabItem>
     <TabItem x:Name="AssetsTab" Header="Assets" Visibility="Collapsed"><Grid DataContext="{Binding SelectedDocument}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="4"><TextBox x:Name="AssetFilter" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter this file by name or record ID" AutomationProperties.Name="Filter this file by name or ID"/><TextBlock Text="Filter this file by name or ID…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=AssetFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <ComboBox Grid.Row="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindFilter}" Margin="4" AutomationProperties.Name="Asset type filter"/>
      <Grid Grid.Row="2"><DataGrid Background="Transparent" RowBackground="Transparent" x:Name="AssetGrid" PreviewMouseRightButtonDown="AssetContextTarget" ItemsSource="{Binding FilteredAssets}" SelectedItem="{Binding SelectedAsset,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" MinRowHeight="28" ColumnHeaderHeight="28" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" LoadingRow="AssetLoadingRow" SelectionChanged="AssetSelectionChanged" BorderThickness="0" GridLinesVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <DataGrid.ContextMenu><ContextMenu Opened="AssetContextOpening"><MenuItem x:Name="AssetPropertiesMenu" Header="Properties…" InputGestureText="Alt+Enter" Click="AssetPropertiesClick"/><Separator/><MenuItem Header="Export selected…" Click="ExportSelectedClick" /><MenuItem Header="Export selected as JSON…" Click="ExportJsonClick" /></ContextMenu></DataGrid.ContextMenu>
          <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="MinHeight" Value="56"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Animation"><Setter Property="MinHeight" Value="30"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTemplateColumn Width="*" Header="Name" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
           <Grid x:Name="AssetRow" Margin="4"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Animation"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#16808080" CornerRadius="4" Width="44" Height="44"><Grid><TextBlock x:Name="AssetPlaceholder" Text="▧" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Identity}" FontSize="12" /></StackPanel>
           </Grid>
           <Grid Visibility="Collapsed" x:Name="AnimationAssetRow" Margin="5,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="Animation"><Setter TargetName="AnimationAssetRow" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Texture"><Setter TargetName="AssetPlaceholder" Property="Visibility" Value="Collapsed" /></DataTrigger></DataTemplate.Triggers>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ID" Binding="{Binding Index}" Width="46" Visibility="Collapsed"/><DataGridTextColumn Header="Sequences" Binding="{Binding SequenceCount}" Width="SizeToHeader" MinWidth="92" Visibility="Collapsed"/></DataGrid.Columns>
         </DataGrid>
         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=AssetGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="No assets match these filters." TextWrapping="Wrap"/><Button Content="Clear filters" Click="ClearAssetFilterClick"/></StackPanel>
        </Grid>
     </Grid></TabItem>
     <TabItem x:Name="SearchTab" Header="Search"><DockPanel><Grid x:Name="GlobalSearchHost" DockPanel.Dock="Top" Margin="4"><TextBox x:Name="GlobalSearch" Text="{Binding GlobalQuery,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search all assets in this root (at least two characters)" AutomationProperties.Name="Search all assets"/><TextBlock Text="Search all assets…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=GlobalSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock x:Name="SearchHint" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="8"/><ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" MouseDoubleClick="SearchDoubleClick" KeyDown="SearchKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5" ToolTip="{Binding File}"><DockPanel><TextBlock Text="{Binding Identity}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/></DockPanel><TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
     <TabItem x:Name="DocumentSceneTab" Header="Document scene" Visibility="Collapsed"><TreeView x:Name="DocumentSceneTree" ItemsSource="{Binding SelectedDocument.SceneRoots}" SelectedItemChanged="SceneTreeSelected" PreviewMouseRightButtonDown="SceneContextTarget"><TreeView.ContextMenu><ContextMenu Opened="SceneContextOpening"><MenuItem x:Name="ScenePropertiesMenu" Header="Properties…" InputGestureText="Alt+Enter" Click="ScenePropertiesClick"/></ContextMenu></TreeView.ContextMenu></TreeView></TabItem>
    </TabControl>

   </Grid>
   <GridSplitter x:Name="NavigatorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" DragCompleted="WorkspaceSplitterCompleted" AutomationProperties.Name="Resize Navigator"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="ToolsSplitterRow" Height="6"/><RowDefinition x:Name="ToolsRow" Height="180"/></Grid.RowDefinitions>
    <Grid x:Name="Workspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#20D99A28" Padding="10,5" Visibility="{Binding SelectedDocument.IsStale,Converter={StaticResource BoolVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="Reload" Click="ReloadClick"/><TextBlock Text="Source file changed on disk. Reload to update." VerticalAlignment="Center"/></DockPanel></Border>
     <Grid Grid.Row="1"><Grid xmlns:ns2="clr-namespace:Recoil.Zbd.Desktop"  Margin="4">
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <StackPanel Margin="8,4"><TextBlock x:Name="PreviewTitle" Text="Select an asset" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PreviewSubtitle" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel>
       <WrapPanel x:Name="ImageToolbar" Grid.Row="1" Visibility="Collapsed" Margin="4"><Button Content="Fit" Click="FitImageClick" /><Button Content="1:1" Click="ActualImageClick" ToolTip="One texture pixel per screen pixel" /><ComboBox x:Name="ChannelCombo" SelectedIndex="0" SelectionChanged="ImageOptionsChanged" Width="90" VerticalAlignment="Center" Margin="5"><ComboBoxItem Content="RGBA" /><ComboBoxItem Content="RGB" /><ComboBoxItem Content="Alpha" /><ComboBoxItem Content="Red" /><ComboBoxItem Content="Green" /><ComboBoxItem Content="Blue" /></ComboBox><TextBlock Text="Zoom" VerticalAlignment="Center" Margin="6,0,2,0"/><Slider AutomationProperties.Name="Texture zoom" x:Name="ZoomSlider" Minimum="0.05" Maximum="16" Value="1" Width="110" VerticalAlignment="Center" ValueChanged="ZoomChanged" /><TextBlock x:Name="TextureZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="42"/><Button Content="Palette / header" Click="PaletteClick" /><CheckBox x:Name="SmoothImage" Content="Smooth" VerticalAlignment="Center" Checked="ImageOptionsChanged" Unchecked="ImageOptionsChanged" /></WrapPanel>
       <ToolBar x:Name="SceneToolbar" Grid.Row="1" Visibility="Collapsed" ToolBarTray.IsLocked="True" Margin="4">
 <ComboBox x:Name="LodCombo" Style="{StaticResource PreviewLodPicker}" SelectionChanged="SceneSourceChanged" ToolTip="Detail level per object. LOD 0 is highest detail." AutomationProperties.Name="Scene LOD" ToolBar.OverflowMode="Never"/>
 <StackPanel x:Name="WorldDifficultyGroup" Orientation="Horizontal" ToolBar.OverflowMode="Never"><ComboBox x:Name="WorldDifficulty" Style="{StaticResource PreviewDifficultyPicker}" SelectedItem="{Binding Difficulty,Mode=TwoWay}" ToolTip="Mission difficulty" AutomationProperties.Name="Mission difficulty"/></StackPanel>
 <Button x:Name="FrameScene" Style="{StaticResource PreviewIconButton}" Click="FrameSceneClick" ToolBar.OverflowMode="Never" ToolTip="Frame all visible scene geometry" AutomationProperties.Name="Frame all"><local:PreviewIcon Kind="Frame"/></Button>
 <StackPanel x:Name="PickupTools" Orientation="Horizontal" Visibility="Collapsed" ToolBar.OverflowMode="Never" Margin="6,0"><ToggleButton x:Name="PickupLocked" Style="{StaticResource PreviewIconToggle}" IsChecked="True" Checked="PickupLockedChanged" Unchecked="PickupLockedChanged" AutomationProperties.Name="Lock pickup editing" Tag="When locked, selection and inspection remain available; movement is disabled."><local:PreviewIcon Kind="Lock" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton></StackPanel>
 <ToggleButton x:Name="Wireframe" Style="{StaticResource PreviewIconToggle}" IsChecked="False" Checked="SceneOptionsChanged" Unchecked="SceneOptionsChanged" AutomationProperties.Name="Wireframe" Tag="Show mesh edges."><local:PreviewIcon Kind="Wireframe" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
 <ToggleButton x:Name="TexturesEnabled" Style="{StaticResource PreviewIconToggle}" IsChecked="True" Checked="SceneOptionsChanged" Unchecked="SceneOptionsChanged" AutomationProperties.Name="Textures" Tag="Show surface textures."><local:PreviewIcon Kind="Textures" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
 <ToggleButton x:Name="BoundsEnabled" Style="{StaticResource PreviewIconToggle}" IsChecked="False" Checked="SceneOptionsChanged" Unchecked="SceneOptionsChanged" AutomationProperties.Name="Bounds" Tag="Show object bounding boxes."><local:PreviewIcon Kind="Bounds" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
 <ToggleButton x:Name="BackdropEnabled" Style="{StaticResource PreviewIconToggle}" IsChecked="False" Checked="SceneSourceChanged" Unchecked="SceneSourceChanged" AutomationProperties.Name="Horizon" Tag="Show the mission horizon."><local:PreviewIcon Kind="Horizon" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
 <ToggleButton x:Name="FlyEnabled" Style="{StaticResource PreviewIconToggle}" IsChecked="False" Checked="FlyChanged" Unchecked="FlyChanged" AutomationProperties.Name="Fly camera" Tag="Capture freecam controls: WASD move, Space/C up/down, mouse look, wheel speed. Escape releases controls."><local:PreviewIcon Kind="Fly" IsChecked="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></ToggleButton>
 <Menu ToolBar.OverflowMode="AsNeeded" Margin="6,0,0,0"><MenuItem Header="Scene"><MenuItem StaysOpenOnClick="True"><MenuItem.Header><StackPanel><Label Content="Texture variant" Target="{Binding ElementName=TexturePackCombo}"/><ComboBox x:Name="TexturePackCombo" Width="250" Margin="5" SelectionChanged="SceneSourceChanged" ToolTip="Texture quality variant" AutomationProperties.Name="Texture variant"/></StackPanel></MenuItem.Header></MenuItem></MenuItem><MenuItem Header="Selection"><MenuItem Header="Isolate selected node" Click="IsolateClick"/><MenuItem Header="Show all" Click="ShowAllClick"/></MenuItem></Menu>
</ToolBar>
       <Grid Grid.Row="2" x:Name="PreviewHost">
        <TextBlock x:Name="EmptyPreview" Text="Select an asset to inspect it" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
        <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" Background="{StaticResource Checker}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ImageWheel">
         <Grid x:Name="ImageSurface" Background="Transparent" MouseDown="ImagePanStart" MouseUp="ImagePanEnd" MouseMove="ImagePanMove" LostMouseCapture="ImagePanCanceled" Unloaded="ImagePanCanceled">
          <Image x:Name="TextureImage" Stretch="Fill" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" MouseMove="ImagePixelMove" />
         </Grid>
        </ScrollViewer>
        <ContentControl x:Name="SceneHost" Visibility="Collapsed" />
        <Border x:Name="FlyHint" Panel.ZIndex="10" Visibility="Collapsed" IsHitTestVisible="False" Background="#D920252C" CornerRadius="5" Padding="10,6" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock x:Name="FlyHintText" Foreground="White" FontSize="12" TextWrapping="Wrap"/></Border>
        <ContentControl x:Name="AnimationHost" Visibility="Collapsed" />
        <Grid x:Name="AudioPanel" Visibility="Collapsed" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="180" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock x:Name="AudioDetails" Margin="0,15" TextWrapping="Wrap" /><ns2:WaveformView x:Name="Waveform" Grid.Row="1" /><Slider x:Name="AudioSeek" Grid.Row="2" Minimum="0" ValueChanged="AudioSeekChanged" /><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10"><Button x:Name="AudioPlayButton" Content="Play" AutomationProperties.Name="Play audio" Click="PlayAudioClick" /><Button Content="Stop" Click="StopAudioClick" /><TextBlock x:Name="AudioTime" VerticalAlignment="Center" Margin="15,0" /></StackPanel><ListBox x:Name="AudioCues" Grid.Row="4" MaxHeight="220" VerticalAlignment="Top" MouseDoubleClick="CueDoubleClick" /></Grid>
        <TabControl x:Name="StructuredPanel" Visibility="Collapsed"><TabItem Header="Data"><TreeView x:Name="CentralTree"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle></TreeView></TabItem><TabItem Header="Text"><TextBox x:Name="ContentText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></TabItem><TabItem Header="Sequence events" x:Name="EventsTab" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DataGrid Background="Transparent" RowBackground="Transparent" x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="EventSelected" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="*" /><DataGridTextColumn Header="Event" Binding="{Binding Type}" Width="*" /><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*" /><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="90" /></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Margin="8" Text="Thresholds describe engine scheduling; this view does not simulate playback." TextWrapping="Wrap" Opacity="0.65" /></Grid></TabItem></TabControl>
       </Grid>
       <DockPanel Grid.Row="3"><Button x:Name="PreviewNotices" DockPanel.Dock="Right" Visibility="Collapsed" Click="PreviewNoticesClick"/><TextBlock x:Name="PreviewInfo" FontSize="11" Opacity="0.65" Margin="8,5" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" /></DockPanel>
      </Grid>
      </Grid>
    </Grid>
    <GridSplitter x:Name="ToolsSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" DragCompleted="WorkspaceSplitterCompleted" AutomationProperties.Name="Resize bottom tools"/>
    <DockPanel x:Name="BottomTools" Grid.Row="2">
     <StackPanel DockPanel.Dock="Right" Orientation="Vertical"><Button Content="↕" Tag="Layout" Click="MaximizeToolsClick" ToolTip="Maximize / restore tools" AutomationProperties.Name="Maximize or restore bottom tools"/><Button Content="×" Tag="Layout" Click="ToolsButtonClick" ToolTip="Hide tools" AutomationProperties.Name="Hide bottom tools"/></StackPanel>
     <TabControl x:Name="ToolTabs" SelectionChanged="ToolSelectionChanged">
      <TabItem Header="Dispatch" x:Name="DispatchTab"><ContentControl x:Name="DispatchHost"/></TabItem>
      <TabItem Header="Event log" x:Name="EventLogTab"><ContentControl x:Name="EventLogHost"/></TabItem>
      <TabItem Header="Problems"><Grid><ContentControl x:Name="ProblemsHost"/><Expander x:Name="DiagnosticsExpander" IsExpanded="True"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="File and preview notices" VerticalAlignment="Center"/><Button x:Name="FileProblemDetailsButton" Content="Details…" Click="FileProblemDetailsClick" IsEnabled="False" Margin="10,0,0,0"/></StackPanel></Expander.Header><DockPanel><DataGrid x:Name="FileProblems" SelectionChanged="FileProblemSelectionChanged" ItemsSource="{Binding Problems}" Background="Transparent" RowBackground="Transparent" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" MouseDoubleClick="FileProblemDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="SizeToHeader" MinWidth="100"/><DataGridTextColumn Header="Source" Binding="{Binding Scope}" Width="140"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle></DataGrid></DockPanel></Expander></Grid></TabItem>
      <TabItem Header="Runtime" x:Name="RuntimeTab"><ContentControl x:Name="RuntimeHost"/></TabItem>
      <TabItem Header="Related" ToolTip="Name-based matches; not a complete dependency graph"><Grid><ListBox x:Name="RelatedList" Background="Transparent" BorderThickness="0" MouseDoubleClick="RelatedDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /><TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.6" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="No name-based matches for this asset." Margin="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=RelatedList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></TabItem>
      <TabItem Header="Bytes"><TextBox x:Name="RawText" Background="Transparent" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" /></TabItem>
     </TabControl>
    </DockPanel>
<StackPanel Grid.RowSpan="3" x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="580" Margin="30"><TextBlock x:Name="WelcomeTitle" Text="Explore Recoil’s assets" FontSize="32" FontWeight="SemiBold" /><TextBlock x:Name="WelcomeDescription" Text="Textures, worlds, models, audio, scripts, and animation sequences — together in one workspace." FontSize="16" Opacity="0.65" Margin="0,16,0,26" TextWrapping="Wrap" /><Button x:Name="WelcomeOpen" Content="Choose a ZBD folder…" HorizontalAlignment="Left" Click="OpenFolderClick" Padding="22,12" /><TextBlock x:Name="WelcomeHelp" Text="Open the folder containing image.zbd and the mission directories.&#10;You can also drop a folder or a ZBD file here." Opacity="0.55" Margin="0,24,0,0" TextWrapping="Wrap" /></StackPanel>

   </Grid>
   <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" DragCompleted="WorkspaceSplitterCompleted" AutomationProperties.Name="Resize Inspector"/>
   <Grid x:Name="InspectorHost" Grid.Column="4" Visibility="Collapsed">
   <TabControl x:Name="InspectorTabs" Background="{DynamicResource TabViewItemHeaderBackgroundSelected}" SelectionChanged="InspectorSelectionChanged">
    <TabItem x:Name="ProgramTab" Header="Sequences" ToolTip="Animation sequences and their ordered events" Visibility="Collapsed"><ContentControl x:Name="ProgramHost"/></TabItem>
    <TabItem x:Name="PreviewSetupTab" Header="Settings" Visibility="Collapsed"><ContentControl x:Name="PreviewSetupHost"/></TabItem>
    <TabItem x:Name="ReferencesTab" Header="References" Visibility="Collapsed"><ContentControl x:Name="ReferencesHost"/></TabItem>
   </TabControl>
   </Grid>
  </Grid>
 </DockPanel>
 </Grid>
</Window>
