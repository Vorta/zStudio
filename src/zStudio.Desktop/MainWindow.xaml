<Window x:Class="zStudio.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:zStudio.Desktop"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="zStudio" Icon="/zStudio.Desktop;component/Assets/studio.ico" Width="1560" Height="940" MinWidth="1080" MinHeight="650"
 Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
 <Window.Resources>
  <SolidColorBrush x:Key="AssetIconBrush" Color="#3C91D4"/>
  <local:InverseBool x:Key="InverseBool"/>
  <SolidColorBrush x:Key="ReloadingShade" Color="#8C000000"/>
  <SolidColorBrush x:Key="CaptionHoverBrush" Color="#20808080"/><SolidColorBrush x:Key="CaptionPressedBrush" Color="#40808080"/>
  <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
   <DockPanel ToolTip="{Binding ToolTip}" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Document}" Click="CloseFileClick" Visibility="{Binding IsOpen,Converter={StaticResource BoolVisibility}}" Padding="5,0" Margin="6,0,1,0" MinWidth="24" MinHeight="24" ToolTip="Close file" AutomationProperties.Name="Close file"/>
    <TextBlock x:Name="OpenFileMarker" DockPanel.Dock="Left" Text="●" FontSize="8" Width="6" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Hidden" Foreground="{StaticResource AssetIconBrush}"/>
    <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <Viewbox x:Name="FolderGlyph" Visibility="Collapsed">
      <Canvas Width="20" Height="20">
       <Path Data="M2,5 Q2,3.5 3.5,3.5 H7 L9,5.5 H16.5 Q18,5.5 18,7 V15 Q18,16.5 16.5,16.5 H3.5 Q2,16.5 2,15 Z" Fill="#2C73AC" Stroke="#225780" StrokeThickness="0.8"/>
       <Path x:Name="FolderFront" Data="M2,8 H18 V15 Q18,16.5 16.5,16.5 H3.5 Q2,16.5 2,15 Z" Fill="{StaticResource AssetIconBrush}" Stroke="#2B6794" StrokeThickness="0.8"/>
      </Canvas>
     </Viewbox>
     <TextBlock x:Name="FileGlyph" Text="{Binding FileIcon}" Foreground="{StaticResource AssetIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="FileName" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding File}" Value="{x:Null}">
     <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible"/>
     <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed"/>
     <Setter TargetName="OpenFileMarker" Property="Visibility" Value="Collapsed"/>
    </DataTrigger>
   <DataTrigger Binding="{Binding IsExpanded,RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
     <Setter TargetName="FolderFront" Property="Data" Value="M5,8 H18 Q19,8 18.6,9.2 L16.5,15.5 Q16.2,16.5 15,16.5 H2.5 L4,9 Q4.2,8 5,8 Z"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter TargetName="FileName" Property="FontWeight" Value="SemiBold"/><Setter TargetName="OpenFileMarker" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="FileName" Property="TextDecorations" Value="Underline"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:ResourceTreeItem}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" /></HierarchicalDataTemplate><HierarchicalDataTemplate DataType="{x:Type local:InspectorNode}" ItemsSource="{Binding Children}">
   <TextBlock Text="{Binding Label}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis"/>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:SceneTreeItem}" ItemsSource="{Binding Children}">
   <Grid ToolTipService.ShowsToolTipOnKeyboardFocus="False">
    <!-- The tooltip; an Animations row's first line (its name) in SemiBold. -->
    <Grid.ToolTip><TextBlock TextWrapping="Wrap"><Run Text="{Binding ToolTipTitle,Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding ToolTipBody,Mode=OneWay}"/></TextBlock></Grid.ToolTip>
    <Border x:Name="CompiledRow" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Padding="6,2,2,2">
     <DockPanel><TextBlock Text="{Binding Glyph}" Opacity="0.7" Margin="0,0,6,0"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
    <DockPanel x:Name="SourceRow" Visibility="Collapsed" Height="28" Background="Transparent" local:OutlinerRowStretch.Enabled="True" MouseLeftButtonDown="OutlinerRowMouseDown" FocusVisualStyle="{StaticResource OutlinerFocusRing}">
     <Button x:Name="RowEye" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Focusable="False" Click="OutlinerEyeClick" PreviewMouseUp="OutlinerEyeMiddleClick" Tag="{Binding}" ToolTip="{Binding EyeToolTip}" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="0" AutomationProperties.Name="{Binding EyeToolTip}"><local:PreviewIcon Kind="{Binding EyeIcon}" Width="14" Height="14"/></Button>
     <!-- The Pickups row's Group by type: a row per catalog type inside Weapons, Ammo and Other. -->
     <Button x:Name="RowGroupByType" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource OutlinerEye}" Focusable="False" Click="OutlinerGroupByTypeClick" Tag="{Binding}" Margin="0,0,2,0" ToolTipService.InitialShowDelay="0" ToolTip="Group by type: inside Weapons, Ammo and Other, one row per type with its count" AutomationProperties.Name="{Binding GroupByTypeName}"><local:PreviewIcon Kind="GroupByType" Width="14" Height="14"/></Button>
     <!-- The Zones row's Objects | Polygons switch: the kind of colour its shown zones take. -->
     <Border x:Name="ZoneHeaderControls" DockPanel.Dock="Right" Visibility="Collapsed" Padding="2" Margin="0,0,4,0" CornerRadius="5" BorderThickness="1" Background="#38000000" BorderBrush="#10FFFFFF" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ZoneKindsToolTip}" AutomationProperties.Name="Colour zones by">
      <StackPanel Orientation="Horizontal">
       <Button x:Name="ZoneKindObjects" Style="{StaticResource OutlinerSegment}" Focusable="False" Click="OutlinerZoneKindClick" Tag="{Binding}" ToolTipService.InitialShowDelay="0" ToolTip="Object zones — colour each object by the zone that decides whether it is drawn" AutomationProperties.Name="Object zones"><local:PreviewIcon Kind="Zones" Width="14" Height="14"/></Button>
       <Button x:Name="ZoneKindPolygons" Style="{StaticResource OutlinerSegment}" Focusable="False" Click="OutlinerZoneKindClick" Tag="{Binding}" ToolTipService.InitialShowDelay="0" ToolTip="Polygon zones — colour each polygon by the zones it makes current when the camera or a vehicle is on it; striped where it has several" AutomationProperties.Name="Polygon zones"><local:PreviewIcon Kind="PolygonZones" Width="14" Height="14"/></Button>
      </StackPanel>
     </Border>
     <Button x:Name="RowFrame" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Focusable="False" Click="OutlinerFrameClick" Tag="{Binding}" ToolTip="{Binding FrameToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding FrameToolTip}"><local:PreviewIcon Kind="FrameSelection" Width="14" Height="14"/></Button>
     <!-- A definition or binding row's Open: Animation mode on it (Enter and a double-click on the row do the same). -->
     <Button x:Name="RowOpen" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource OutlinerEye}" Focusable="False" Click="OutlinerOpenAnimationClick" Tag="{Binding}" ToolTip="{Binding OpenAnimationToolTip}" ToolTipService.InitialShowDelay="0" AutomationProperties.Name="{Binding OpenAnimationToolTip}"><local:PreviewIcon Kind="Open" Width="12" Height="12"/></Button>
     <TextBlock x:Name="RowMeta" DockPanel.Dock="Right" Text="{Binding Meta}" ToolTip="{Binding MetaToolTip}" FontSize="11" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular"/>
     <!-- A definition's status: a later definition with an earlier one's name (⧉). -->
     <Border x:Name="RowDuplicate" DockPanel.Dock="Right" Visibility="Collapsed" Width="16" Height="16" Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center" ToolTip="{Binding DuplicateToolTip}" AutomationProperties.Name="Same name as an earlier definition">
      <local:PreviewIcon Kind="Duplicate" Width="13" Height="13" TextElement.Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></Border>
     <!-- After Exit, the kept scenario's definition: an accent dot. -->
     <Ellipse x:Name="RowKept" DockPanel.Dock="Right" Visibility="Collapsed" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="{Binding KeptToolTip}"/>
     <!-- A closed file, start group or Common holding an animation bound to the selected object: an amber dot before its count. -->
     <Ellipse x:Name="RowHoldsMark" DockPanel.Dock="Right" Visibility="Collapsed" Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{Binding BoundMarkBrush}" ToolTip="Holds an animation bound to the selected object"/>
     <!-- A definition bound to the selected object: Animation mode's amber bar where the selection's accent bar is. -->
     <Canvas x:Name="RowBoundMark" Visibility="Collapsed" Width="0"><Rectangle Canvas.Left="-35" Canvas.Top="6" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{Binding BoundMarkBrush}" ToolTip="Bound to the selected object"/></Canvas>
     <!-- The type icon, or a zone's or network's colour square (dashed for polygons without a zone). -->
     <Grid x:Name="RowIconBox" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
      <local:PreviewIcon x:Name="RowIcon" Kind="{Binding OutlinerIcon}" TextElement.Foreground="{Binding OutlinerBrush}"/>
      <Image x:Name="RowPickupIcon" Visibility="Collapsed" Source="{Binding PickupImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding PickupPictureToolTip}"/>
      <Canvas x:Name="RowWeapon" Visibility="Collapsed"><Grid Canvas.Left="-12" Width="32" Height="20" Background="Transparent" ToolTip="{Binding PickupPictureToolTip}"><Image Source="{Binding PickupImage}" Stretch="Uniform" HorizontalAlignment="Right" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Canvas>
      <Border x:Name="RowSwatch" Visibility="Collapsed" Width="12" Height="12" CornerRadius="3" BorderThickness="1" BorderBrush="#47FFFFFF" Background="{Binding Swatch}"/>
      <Rectangle x:Name="RowSwatchDashed" Visibility="Collapsed" Width="12" Height="12" RadiusX="3" RadiusY="3" StrokeThickness="1" StrokeDashArray="2,2" Stroke="{DynamicResource TextFillColorTertiaryBrush}"/>
     </Grid>
     <!-- The name, then a label, file or folder on the same line (it trims first), then marks (animations bind to it; a warning;
          the zone being painted). -->
     <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <!-- The target follows the name in one line, so it trims first and the name last (§5). -->
      <TextBlock x:Name="RowName" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding OutlinerLabel,Mode=OneWay}"/><Run Text="{Binding SecondaryRunText,Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text="{Binding TargetRunText,Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><Run Text="{Binding TargetQuietRunText,Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextFillColorDisabledBrush}"/></TextBlock>
      <TextBlock x:Name="RowNumber" Grid.Column="1" Text="{Binding PickupNumberText}" Visibility="{Binding HasPickupNumber,Converter={StaticResource BoolVisibility}}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular"/>
      <!-- The animated mark: a click lists the animations affecting the object, each with Open. -->
      <Button Grid.Column="2" Style="{StaticResource OutlinerEye}" Width="20" Height="20" Margin="4,0,0,0" VerticalAlignment="Center" Focusable="False" Visibility="{Binding IsAnimated,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding AnimationsToolTip}" Click="OutlinerAnimationGlyphClick" Tag="{Binding}" AutomationProperties.Name="Animations affecting this object">
       <local:PreviewIcon Kind="Animated" Width="14" Height="14" TextElement.Foreground="{Binding AnimationBrush}"/></Button>
      <Border Grid.Column="3" Background="Transparent" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasWarning,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding WarningToolTip}">
       <local:PreviewIcon Kind="Warning" Width="12" Height="12" TextElement.Foreground="#FCE100"/></Border>
      <Border Grid.Column="4" Background="Transparent" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsPaintZone,Converter={StaticResource BoolVisibility}}" ToolTip="Zone being painted">
       <local:PreviewIcon Kind="Brush" Width="12" Height="12" TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Border>
     </Grid>
    </DockPanel>
   </Grid>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsSourceMap}" Value="True"><Setter TargetName="CompiledRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="SourceRow" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding HasPickupIcon}" Value="True"><Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowPickupIcon" Property="Visibility" Value="Visible"/><Setter TargetName="RowIconBox" Property="Width" Value="20"/><Setter TargetName="RowIconBox" Property="Height" Value="20"/></DataTrigger>
    <!-- A weapon pickup shows the weapon (32×20, reaching into the empty chevron column); a weapon type's row a 32 DIP box. -->
    <DataTrigger Binding="{Binding IsWeaponPickup}" Value="True"><Setter TargetName="RowPickupIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowWeapon" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding IsWeaponTypeRow}" Value="True"><Setter TargetName="RowIconBox" Property="Width" Value="32"/></DataTrigger>
    <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding IsFaded}" Value="True"><Setter TargetName="SourceRow" Property="Opacity" Value="0.55"/></DataTrigger>
    <DataTrigger Binding="{Binding IsIsolated}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding CanHide}" Value="False"><Setter TargetName="RowEye" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding CanFrame}" Value="False"><Setter TargetName="RowFrame" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <!-- An empty node draws nothing: no Frame or eye, but their space stays so its zone lines up with its neighbours'. -->
    <DataTrigger Binding="{Binding IsEmptyNode}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Hidden"/><Setter TargetName="RowFrame" Property="Visibility" Value="Hidden"/></DataTrigger>
    <!-- A unit or pickup only other difficulties place: dimmed, with its difficulties lined up with the others'. -->
    <DataTrigger Binding="{Binding IsOtherDifficulty}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Hidden"/><Setter TargetName="RowFrame" Property="Visibility" Value="Hidden"/><Setter TargetName="SourceRow" Property="Opacity" Value="0.45"/></DataTrigger>
    <!-- Sections: a SemiBold name; a zone's or network's colour square; a dimmed unbound definition; a note in tertiary text. -->
    <DataTrigger Binding="{Binding IsSectionHeader}" Value="True"><Setter TargetName="RowName" Property="FontWeight" Value="SemiBold"/></DataTrigger>
    <DataTrigger Binding="{Binding HasSwatch}" Value="True"><Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding SwatchDashed}" Value="True"><Setter TargetName="RowSwatchDashed" Property="Visibility" Value="Visible"/><Setter TargetName="RowName" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasSwatch}" Value="True"/><Condition Binding="{Binding SwatchDashed}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="RowSwatch" Property="Visibility" Value="Visible"/></MultiDataTrigger>
    <DataTrigger Binding="{Binding IsDimmed}" Value="True"><Setter TargetName="SourceRow" Property="Opacity" Value="0.45"/></DataTrigger>
    <DataTrigger Binding="{Binding IsNote}" Value="True"><Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowName" Property="FontSize" Value="12"/><Setter TargetName="RowName" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
    <!-- The Zones, AI Networks, AI Vehicles and Pickups rows always have their master eye. -->
    <DataTrigger Binding="{Binding HasMasterEye}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/></DataTrigger>
    <!-- Pickups' groups: an empty one keeps its Frame and eye, waiting (their tooltips say why); one whose pickups are all on
         other difficulties is dimmed without them; the Pickups row's Group by type toggle. -->
    <DataTrigger Binding="{Binding IsPickupGroup}" Value="True"><Setter TargetName="RowIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsEmptyPickupGroup}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/><Setter TargetName="RowEye" Property="IsEnabled" Value="False"/><Setter TargetName="RowEye" Property="Opacity" Value="0.36"/><Setter TargetName="RowFrame" Property="Visibility" Value="Visible"/><Setter TargetName="RowFrame" Property="IsEnabled" Value="False"/><Setter TargetName="RowFrame" Property="Opacity" Value="0.36"/></DataTrigger>
    <DataTrigger Binding="{Binding IsOtherDifficultyGroup}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Hidden"/><Setter TargetName="RowFrame" Property="Visibility" Value="Hidden"/></DataTrigger>
    <DataTrigger Binding="{Binding HasGroupByType}" Value="True"><Setter TargetName="RowGroupByType" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding CanOpenAnimation}" Value="True"><Setter TargetName="RowOpen" Property="Visibility" Value="Visible"/><Setter TargetName="RowMeta" Property="Margin" Value="8,0,4,0"/></DataTrigger>
    <DataTrigger Binding="{Binding PickupsByTypeOn}" Value="True"><Setter TargetName="RowGroupByType" Property="local:CommandState.IsOn" Value="True"/></DataTrigger>
    <!-- Animations (design/world-tree-animations.md §6–7): a binding's cube; a definition bound to nothing
         (tertiary name, glyph at 55 %); the opened definition's pressed Open; ⧉, the kept dot and the amber marks; no Frame below 260 DIP. -->
    <DataTrigger Binding="{Binding IsAnimationBinding}" Value="True"><Setter TargetName="RowIcon" Property="Width" Value="13"/><Setter TargetName="RowIcon" Property="Height" Value="13"/></DataTrigger>
    <DataTrigger Binding="{Binding IsUnboundDefinition}" Value="True"><Setter TargetName="RowIcon" Property="Opacity" Value="0.55"/><Setter TargetName="RowName" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsOpenedAnimation}" Value="True"><Setter TargetName="RowOpen" Property="local:CommandState.IsOn" Value="True"/></DataTrigger>
    <DataTrigger Binding="{Binding HasDuplicateName}" Value="True"><Setter TargetName="RowDuplicate" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding IsKeptAnimation}" Value="True"><Setter TargetName="RowKept" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding HoldsBoundMark}" Value="True"><Setter TargetName="RowHoldsMark" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding ShowsBoundMark}" Value="True"><Setter TargetName="RowBoundMark" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding HidesAnimationFrame}" Value="True"><Setter TargetName="RowFrame" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding SectionKind}" Value="zones"><Setter TargetName="ZoneHeaderControls" Property="Visibility" Value="Visible"/></DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ZoneKindPolygons}" Value="True"/><Condition Binding="{Binding HeaderActive}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="ZoneKindPolygons" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="ZoneKindPolygons" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></MultiDataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ZoneKindPolygons}" Value="False"/><Condition Binding="{Binding HeaderActive}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="ZoneKindObjects" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="ZoneKindObjects" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></MultiDataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ZoneKindPolygons}" Value="True"/><Condition Binding="{Binding HeaderActive}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="ZoneKindPolygons" Property="Background" Value="#15FFFFFF"/><Setter TargetName="ZoneKindPolygons" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></MultiDataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ZoneKindPolygons}" Value="False"/><Condition Binding="{Binding HeaderActive}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="ZoneKindObjects" Property="Background" Value="#15FFFFFF"/><Setter TargetName="ZoneKindObjects" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></MultiDataTrigger>
    <!-- Only the switch waits while no zone's colour shows; the row's icon and name never fade. -->
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SectionKind}" Value="zones"/><Condition Binding="{Binding ZoneKindsEnabled}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="ZoneHeaderControls" Property="IsEnabled" Value="False"/><Setter TargetName="ZoneHeaderControls" Property="Opacity" Value="0.36"/></MultiDataTrigger>
    <DataTrigger Binding="{Binding HeaderPaused}" Value="True"><Setter TargetName="RowEye" Property="IsEnabled" Value="False"/><Setter TargetName="RowEye" Property="Opacity" Value="0.36"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}"><Setter Property="BorderThickness" Value="0"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style x:Key="CaptionButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
   <Setter Property="Width" Value="46"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CaptionHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CaptionPressedBrush}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TitleCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="1,0"/><Setter Property="Focusable" Value="True"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
  </Style>
  <ControlTemplate x:Key="TitleMenuTemplate" TargetType="MenuItem">
   <Grid>
    <Border x:Name="HeaderSurface" Margin="3,4" Padding="8,0" CornerRadius="4" Background="{TemplateBinding Background}">
     <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderSurface}" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
     <Border Padding="0,3" BorderThickness="1" CornerRadius="8" Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
      <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/></Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
 </Window.Resources>
 <Grid>
 <DockPanel x:Name="Shell">
  <Grid x:Name="TitleArea" DockPanel.Dock="Top" Height="42" MinHeight="42" Background="{DynamicResource ApplicationBackgroundBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0"><Image Source="/zStudio.Desktop;component/Assets/studio.ico" Width="20" Height="20"/><TextBlock x:Name="ApplicationTitle" Text="zStudio" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
   <Menu x:Name="AppMenu" Grid.Column="1" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Menu.ItemContainerStyle>
     <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Height" Value="42"/>
      <!-- Fluent selects templates in Role triggers, which override ordinary setters.
           Override those triggers so the compact title row retains full text height. -->
      <Style.Triggers>
       <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Template" Value="{StaticResource TitleMenuTemplate}"/></Trigger>
       <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Template" Value="{StaticResource TitleMenuTemplate}"/></Trigger>
      </Style.Triggers>
     </Style>
    </Menu.ItemContainerStyle>
   <MenuItem Header="_File"><MenuItem x:Name="OpenWorkspaceMenu" Header="_Open workspace…" InputGestureText="Ctrl+O" Click="OpenWorkspaceClick" ToolTip="Open a source project folder (one with data and gamegen)"/><MenuItem x:Name="RecentMenu" Header="Recent folders"/><Separator/>
    <MenuItem x:Name="SaveMenu" Header="_Save" InputGestureText="Ctrl+S" Click="SaveCurrentClick"/>
