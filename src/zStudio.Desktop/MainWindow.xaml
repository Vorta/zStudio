<Window x:Class="zStudio.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:zStudio.Desktop"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="zStudio" Icon="/zStudio.Desktop;component/Assets/studio.ico" Width="1560" Height="940" MinWidth="1080" MinHeight="650"
 Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
 <Window.Resources>
  <SolidColorBrush x:Key="AssetIconBrush" Color="#3C91D4"/>
  <local:InverseBool x:Key="InverseBool"/>
  <SolidColorBrush x:Key="ReloadingShade" Color="#8C000000"/>
  <SolidColorBrush x:Key="CaptionHoverBrush" Color="#20808080"/><SolidColorBrush x:Key="CaptionPressedBrush" Color="#40808080"/>
  <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
   <DockPanel ToolTip="{Binding ToolTip}" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Document}" Click="CloseFileClick" Visibility="{Binding IsOpen,Converter={StaticResource BoolVisibility}}" Padding="5,0" Margin="6,0,1,0" MinWidth="24" MinHeight="24" ToolTip="Close file" AutomationProperties.Name="Close file"/>
    <TextBlock x:Name="OpenFileMarker" DockPanel.Dock="Left" Text="●" FontSize="8" Width="6" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Hidden" Foreground="{StaticResource AssetIconBrush}"/>
    <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <Viewbox x:Name="FolderGlyph" Visibility="Collapsed">
      <Canvas Width="20" Height="20">
       <Path Data="M2,5 Q2,3.5 3.5,3.5 H7 L9,5.5 H16.5 Q18,5.5 18,7 V15 Q18,16.5 16.5,16.5 H3.5 Q2,16.5 2,15 Z" Fill="#2C73AC" Stroke="#225780" StrokeThickness="0.8"/>
       <Path x:Name="FolderFront" Data="M2,8 H18 V15 Q18,16.5 16.5,16.5 H3.5 Q2,16.5 2,15 Z" Fill="{StaticResource AssetIconBrush}" Stroke="#2B6794" StrokeThickness="0.8"/>
      </Canvas>
     </Viewbox>
     <TextBlock x:Name="FileGlyph" Text="{Binding FileIcon}" Foreground="{StaticResource AssetIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="FileName" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding File}" Value="{x:Null}">
     <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible"/>
     <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed"/>
     <Setter TargetName="OpenFileMarker" Property="Visibility" Value="Collapsed"/>
    </DataTrigger>
   <DataTrigger Binding="{Binding IsExpanded,RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
     <Setter TargetName="FolderFront" Property="Data" Value="M5,8 H18 Q19,8 18.6,9.2 L16.5,15.5 Q16.2,16.5 15,16.5 H2.5 L4,9 Q4.2,8 5,8 Z"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter TargetName="FileName" Property="FontWeight" Value="SemiBold"/><Setter TargetName="OpenFileMarker" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="FileName" Property="TextDecorations" Value="Underline"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:ResourceTreeItem}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" /></HierarchicalDataTemplate><HierarchicalDataTemplate DataType="{x:Type local:InspectorNode}" ItemsSource="{Binding Children}">
   <TextBlock Text="{Binding Label}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis"/>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:SceneTreeItem}" ItemsSource="{Binding Children}">
   <Grid ToolTip="{Binding ToolTip}">
    <Border x:Name="CompiledRow" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Padding="6,2,2,2">
     <DockPanel><TextBlock Text="{Binding Glyph}" Opacity="0.7" Margin="0,0,6,0"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
    <DockPanel x:Name="SourceRow" Visibility="Collapsed" Height="28" Background="Transparent" local:OutlinerRowStretch.Enabled="True">
     <Button x:Name="RowEye" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Visibility="Hidden" Click="OutlinerEyeClick" Tag="{Binding}" ToolTip="{Binding EyeToolTip}" AutomationProperties.Name="{Binding EyeToolTip}"><local:PreviewIcon Kind="{Binding EyeIcon}" Width="14" Height="14"/></Button>
     <Button x:Name="RowFrame" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Visibility="Hidden" Click="OutlinerFrameClick" Tag="{Binding}" ToolTip="Frame selection" AutomationProperties.Name="Frame selection"><local:PreviewIcon Kind="FrameSelection" Width="14" Height="14"/></Button>
     <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" ToolTip="{Binding MetaToolTip}" FontSize="11" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
     <local:PreviewIcon Kind="{Binding OutlinerIcon}" TextElement.Foreground="{Binding OutlinerBrush}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
     <!-- The name, then (for an object a mission animation binds to) its icon; the name trims first. -->
     <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding OutlinerLabel}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Border Grid.Column="1" Background="Transparent" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsAnimated,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding AnimationsToolTip}">
       <local:PreviewIcon Kind="Animated" Width="14" Height="14" TextElement.Foreground="#6FC8D6"/></Border>
     </Grid>
    </DockPanel>
   </Grid>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsSourceMap}" Value="True"><Setter TargetName="CompiledRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="SourceRow" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding IsMouseOver,ElementName=SourceRow}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/><Setter TargetName="RowFrame" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/><Setter TargetName="RowFrame" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Visible"/><Setter TargetName="SourceRow" Property="Opacity" Value="0.55"/></DataTrigger>
    <DataTrigger Binding="{Binding CanHide}" Value="False"><Setter TargetName="RowEye" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding CanFrame}" Value="False"><Setter TargetName="RowFrame" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <!-- A unit or pickup only other difficulties place: dimmed, with its difficulties lined up with the others'. -->
    <DataTrigger Binding="{Binding IsOtherDifficulty}" Value="True"><Setter TargetName="RowEye" Property="Visibility" Value="Hidden"/><Setter TargetName="RowFrame" Property="Visibility" Value="Hidden"/><Setter TargetName="SourceRow" Property="Opacity" Value="0.45"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}"><Setter Property="BorderThickness" Value="0"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style x:Key="CaptionButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
   <Setter Property="Width" Value="46"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CaptionHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CaptionPressedBrush}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TitleCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="1,0"/><Setter Property="Focusable" Value="True"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
  </Style>
  <ControlTemplate x:Key="TitleMenuTemplate" TargetType="MenuItem">
   <Grid>
    <Border x:Name="HeaderSurface" Margin="3,4" Padding="8,0" CornerRadius="4" Background="{TemplateBinding Background}">
     <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderSurface}" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
     <Border Padding="0,3" BorderThickness="1" CornerRadius="8" Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
      <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/></Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
 </Window.Resources>
 <Grid>
 <DockPanel x:Name="Shell">
  <Grid x:Name="TitleArea" DockPanel.Dock="Top" Height="42" MinHeight="42" Background="{DynamicResource ApplicationBackgroundBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0"><Image Source="/zStudio.Desktop;component/Assets/studio.ico" Width="20" Height="20"/><TextBlock x:Name="ApplicationTitle" Text="zStudio" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
   <Menu x:Name="AppMenu" Grid.Column="1" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Menu.ItemContainerStyle>
     <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Height" Value="42"/>
      <!-- Fluent selects templates in Role triggers, which override ordinary setters.
           Override those triggers so the compact title row retains full text height. -->
      <Style.Triggers>
       <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Template" Value="{StaticResource TitleMenuTemplate}"/></Trigger>
       <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Template" Value="{StaticResource TitleMenuTemplate}"/></Trigger>
      </Style.Triggers>
     </Style>
    </Menu.ItemContainerStyle>
   <MenuItem Header="_File"><MenuItem x:Name="OpenWorkspaceMenu" Header="_Open workspace…" InputGestureText="Ctrl+O" Click="OpenWorkspaceClick" ToolTip="Open a source project folder (one with data and gamegen)"/><MenuItem x:Name="RecentMenu" Header="Recent folders"/><Separator/>
    <MenuItem x:Name="SaveMenu" Header="_Save" InputGestureText="Ctrl+S" Click="SaveCurrentClick"/><MenuItem x:Name="SaveAsMenu" Header="Save _as…" InputGestureText="Ctrl+Shift+S" Click="SaveCurrentAsClick"/>
    <Separator/><MenuItem x:Name="CloseDocumentMenu" Header="_Close file" InputGestureText="Ctrl+W" Click="CloseCurrentClick"/><MenuItem Header="E_xit" Click="ExitClick"/></MenuItem>
   <MenuItem x:Name="EditMenu" Header="_Edit" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><MenuItem x:Name="UndoMenu" Header="Undo edit" InputGestureText="Ctrl+Z" Click="UndoAnimationClick"/><MenuItem x:Name="RedoMenu" Header="Redo edit" InputGestureText="Ctrl+Y" Click="RedoAnimationClick"/></MenuItem><MenuItem Header="_View"><MenuItem x:Name="FullscreenMenu" Header="Fullscreen" InputGestureText="F11" IsCheckable="True" Tag="fullscreen" Click="PresentationActionClick"/><Separator/><MenuItem Header="_Theme"><MenuItem Header="System" Click="ThemeClick"/><MenuItem Header="Light" Click="ThemeClick"/><MenuItem Header="Dark" Click="ThemeClick"/></MenuItem><MenuItem x:Name="WorkspacePresetMenu" Visibility="Collapsed" Header="Workspace preset"><MenuItem Header="Inspect" Click="PresetClick"/><MenuItem Header="Edit" Click="PresetClick"/><MenuItem Header="Debug" Click="PresetClick"/><MenuItem Header="Focus preview" Click="PresetClick"/></MenuItem><MenuItem x:Name="ResetLayoutMenu" Visibility="Collapsed" Header="Reset layout" Click="ResetLayoutClick"/></MenuItem>
   <MenuItem x:Name="AnimationMenu" Header="_Animation" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><MenuItem Header="Play / pause" InputGestureText="Space" Click="AnimationPlayClick"/><MenuItem Header="Stop" Click="AnimationStopClick"/><MenuItem Header="Previous frame" Click="AnimationPreviousClick"/><MenuItem Header="Next frame" Click="AnimationNextClick"/><Separator/><MenuItem Tag="add-event" Header="Add event…" Click="AnimationAddEventClick"/><MenuItem Tag="add-sequence" Header="Add runtime sequence" Click="AnimationAddSequenceClick"/><MenuItem Tag="duplicate" Header="Duplicate selected record" Click="AnimationDuplicateClick"/><MenuItem Tag="delete" Header="Delete selected record" Click="AnimationDeleteClick"/><Separator/><MenuItem Header="Settings" Click="PreviewSetupClick"/></MenuItem>
   <MenuItem x:Name="ToolsMenu" Header="_Tools" SubmenuOpened="ToolsMenuOpened"><MenuItem Header="MCP integration…" Click="McpIntegrationClick"/><MenuItem x:Name="CompareWorldsMenu" Header="Compare worlds…" Click="CompareWorldsClick" ToolTip="Compare the node trees of two GameZ worlds, such as a retail world and a rebuilt one"/><Separator x:Name="SourceMenuSeparator" Visibility="Collapsed"/><MenuItem x:Name="AddSourceModelMenu" Visibility="Collapsed" IsEnabled="False" Header="Add model to world…" Click="AddSourceModelClick" ToolTip="Adding models is not available yet." ToolTipService.ShowOnDisabled="True"/><MenuItem x:Name="EditInBlenderMenu" Visibility="Collapsed" Header="Edit in Blender…" Click="EditInBlenderClick" ToolTip="Check the selected object's model out into the project's zstudio/export folder for Blender"/><MenuItem x:Name="UpdateFromBlenderMenu" Visibility="Collapsed" Header="Update from Blender export…" Click="UpdateFromBlenderClick" ToolTip="Replace the checked-out model with what Blender exported into its outbox (one undoable edit)"/><MenuItem x:Name="EditZonesMenu" Visibility="Collapsed" Header="Edit map zones…" Click="EditZonesClick" ToolTip="Paint exact faces or objects into map zones; preview, apply and undo through source metadata"/><MenuItem x:Name="CreateTerrainMenu" Visibility="Collapsed" Header="Create terrain…" Click="CreateTerrainClick" ToolTip="Make meshes of a glTF file terrain of this world: a recipe beside the file, painted by region, compiled into grid pieces when the world builds"/><MenuItem x:Name="ConvertTerrainMenu" Visibility="Collapsed" Header="Convert to editable terrain…" Click="ConvertTerrainClick" ToolTip="Turn the mission database's terrain pieces into surfaces of a terrain recipe, keeping their geometry and attributes, and compare the altitude probe before and after"/><Separator Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="ValidateMenu" Header="Validate source file on disk" Click="ValidateClick"/><MenuItem Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}" x:Name="ReloadMenu" Header="Reload current file" InputGestureText="F5" Click="ReloadClick"/></MenuItem>
   <MenuItem x:Name="ExportMenu" Header="E_xport" Visibility="Collapsed" SubmenuOpened="ExportMenuOpened"><MenuItem x:Name="ExportSourceMenu" Header="Export all ZBD files…" Click="ExportSourceClick" ToolTip="Build every game file of this source project into a folder"/><MenuItem x:Name="ExportSourceFileMenu" Header="Export ZBD file" ToolTip="Build one game file of this source project"/><MenuItem x:Name="CheckSourceMenu" Header="Check source project" Click="CheckSourceClick" ToolTip="Build every game file in memory and report problems without writing"/><MenuItem x:Name="SourceProfileMenu" Header="Build profile" ToolTip="Which texture packs exports and checks build: the profiles in gamegen/build-profiles and the built-in original and modern ones"/><Separator/><MenuItem x:Name="TextureDitheringMenu" Header="Texture dithering" ToolTip="How exports and checks convert texture colours to the packs' 16-bit (RGB565) or palette colours; remembered in the project's hidden .zstudio folder"><MenuItem x:Name="DitherNoneItem" Header="None" Tag="none" IsCheckable="True" Click="TextureDitheringClick" ToolTip="Round each texel to the nearest colour on its own"/><MenuItem x:Name="DitherOrderedItem" Header="Ordered" Tag="ordered" IsCheckable="True" Click="TextureDitheringClick" ToolTip="A fixed 4×4 pattern: smooth gradients that tile seamlessly"/><MenuItem x:Name="DitherDiffusionItem" Header="Error diffusion" Tag="diffusion" IsCheckable="True" Click="TextureDitheringClick" ToolTip="Floyd–Steinberg: the smoothest gradients, as fine noise; tiling textures can show a seam"/></MenuItem></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="Controls and formats" Click="HelpClick"/><MenuItem Header="About zStudio" Click="AboutClick"/></MenuItem>
  </Menu>
   <Grid x:Name="DocumentCommands" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="ActiveDocumentTitle" Text="{Binding SelectedDocument.Title}" ToolTip="{Binding SelectedDocument.Path}" MaxWidth="300" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
     <TextBlock x:Name="SourceDocumentTitle" Visibility="Collapsed" ToolTip="{Binding SelectedDocument.Path}" MaxWidth="300" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <Border x:Name="EditedPill" Visibility="Collapsed" CornerRadius="10" Height="20" Padding="8,0" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="The source project has unsaved changes" AutomationProperties.Name="Edited">
      <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}"/><TextBlock Text="Edited" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
     </Border>
    </StackPanel>
    <Button x:Name="DocumentUndo" Grid.Column="1" Style="{StaticResource TitleCommandButtonStyle}" Click="UndoAnimationClick" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A7;"/></Button>
    <Button x:Name="DocumentRedo" Grid.Column="2" Style="{StaticResource TitleCommandButtonStyle}" Click="RedoAnimationClick" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A6;"/></Button>
    <Button x:Name="DocumentSave" Grid.Column="3" Style="{StaticResource TitleCommandButtonStyle}" Click="SaveCurrentClick" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;"/></Button>
   </Grid>
   <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
    <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButtonStyle}" Click="CaptionMinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" ToolTip="Minimize"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE921;"/></Button>
    <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButtonStyle}" Click="CaptionMaximizeClick" AutomationProperties.Name="Maximize" ToolTip="Maximize"><TextBlock x:Name="CaptionMaximizeGlyph" FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE922;"/></Button>
    <Button x:Name="CaptionClose" Tag="Close" Style="{StaticResource CaptionButtonStyle}" Click="CaptionCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" ToolTip="Close"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE8BB;"/></Button>
   </StackPanel>
  </Grid>
  <!-- A source map's command bar: its scope, file commands, LOD and difficulty, then the viewport's commands in labelled groups. -->
  <DockPanel x:Name="SourceCommandBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="10,0,10,4" MinHeight="46" AutomationProperties.Name="Editor commands">

   <WrapPanel x:Name="SourceCommandItems" VerticalAlignment="Center">
    <ContentControl x:Name="SourceScopeHost" VerticalAlignment="Center" Margin="0,3" Focusable="False"/>
    <Border Style="{StaticResource CommandSeparator}"/>
    <StackPanel x:Name="SourceFileCommands" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3"/>
    <Border Style="{StaticResource CommandSeparator}"/>
    <StackPanel x:Name="SourcePickers" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,3,3"/>
    <Border x:Name="SourceCameraGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Camera"><StackPanel Orientation="Horizontal"><TextBlock Text="Camera" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceCameraItems" Orientation="Horizontal"/></StackPanel></Border>
    <Border x:Name="SourceDisplayGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Display"><StackPanel Orientation="Horizontal"><TextBlock Text="Display" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceDisplayItems" Orientation="Horizontal"/></StackPanel></Border>
    <Border x:Name="SourceOverlayGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Color overlays"><StackPanel Orientation="Horizontal"><TextBlock Text="Overlay" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceOverlayItems" Orientation="Horizontal"/></StackPanel></Border>
    <Border x:Name="SourceShowGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Show helpers"><StackPanel Orientation="Horizontal"><TextBlock Text="Show" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceShowItems" Orientation="Horizontal"/></StackPanel></Border>
   </WrapPanel>
  </DockPanel>
  <StatusBar x:Name="PresentationStatusBar" DockPanel.Dock="Bottom" Padding="0" MinHeight="0"><StatusBarItem Padding="4,0" MinHeight="0" HorizontalContentAlignment="Stretch" Width="{Binding ActualWidth,ElementName=Shell}"><DockPanel LastChildFill="True"><StackPanel x:Name="PaneButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><Button x:Name="NavigatorPaneButton" Padding="6,1" Margin="2,0" Content="Navigator" Tag="Layout" Click="NavigatorButtonClick"/><Button x:Name="InspectorPaneButton" Padding="6,1" Margin="2,0" Content="Inspector" Tag="Layout" Click="InspectorButtonClick"/><Button x:Name="ToolsPaneButton" Padding="6,1" Margin="2,0" Content="Tools" Tag="Layout" Click="ToolsButtonClick"/></StackPanel><StackPanel x:Name="SourceStatusRight" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
     <Button x:Name="StatusNotices" Style="{StaticResource CommandButton}" Width="NaN" Height="24" Padding="8,0" Visibility="Collapsed" Click="PreviewNoticesClick" AutomationProperties.Name="Preview notices" ToolTip="Show the preview notices in Problems">
      <StackPanel Orientation="Horizontal"><local:PreviewIcon Kind="Warning" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource SystemFillColorCautionBrush}"/><TextBlock Text="Preview notices" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <Border CornerRadius="8" MinWidth="18" Height="16" Padding="5,0" VerticalAlignment="Center" Background="{DynamicResource SystemFillColorCautionBrush}"><TextBlock x:Name="StatusNoticeCount" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
     </Button>
     <Border Width="1" Height="14" Margin="4,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <ToggleButton x:Name="OutlinerPaneToggle" Style="{StaticResource StatusPaneToggle}" Content="World tree" Tag="outliner" Click="SourcePaneClick" AutomationProperties.Name="World tree" ToolTip="Show or hide the World tree"/>
     <ToggleButton x:Name="PropertiesPaneToggle" Style="{StaticResource StatusPaneToggle}" Content="Properties" Tag="properties" Click="SourcePaneClick" AutomationProperties.Name="Properties pane" ToolTip="Show or hide the Properties pane"/>
     <ToggleButton x:Name="ToolsPaneToggle" Style="{StaticResource StatusPaneToggle}" Content="Diagnostics" Tag="tools" Click="SourcePaneClick" AutomationProperties.Name="Diagnostics pane" ToolTip="Show or hide Diagnostics: the file and preview problems"/>
    </StackPanel>
    <StackPanel x:Name="SourceStatusLeft" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
     <local:PreviewIcon Kind="Pointer" Width="13" Height="13" Margin="8,0,6,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
     <TextBlock x:Name="StatusSelection" Text="No selection" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <TextBlock x:Name="StatusMission" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
     <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <TextBlock x:Name="StatusCounts" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
     <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
    </StackPanel>
