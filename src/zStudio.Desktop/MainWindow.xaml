   <Grid x:Name="DocumentCommands" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="ActiveDocumentTitle" Text="{Binding SelectedDocument.Title}" ToolTip="{Binding SelectedDocument.Path}" MaxWidth="300" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
     <TextBlock x:Name="SourceDocumentTitle" Visibility="Collapsed" ToolTip="{Binding SelectedDocument.Path}" MaxWidth="300" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <Border x:Name="EditedPill" Visibility="Collapsed" CornerRadius="10" Height="20" Padding="8,0" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="The source project has unsaved changes" AutomationProperties.Name="Edited">
      <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}"/><TextBlock Text="Edited" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
     </Border>
    </StackPanel>
    <Button x:Name="DocumentUndo" Grid.Column="1" Style="{StaticResource TitleCommandButtonStyle}" Click="UndoDocumentClick" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A7;"/></Button>
    <Button x:Name="DocumentRedo" Grid.Column="2" Style="{StaticResource TitleCommandButtonStyle}" Click="RedoDocumentClick" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A6;"/></Button>
    <Button x:Name="DocumentSave" Grid.Column="3" Style="{StaticResource TitleCommandButtonStyle}" Click="SaveCurrentClick" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;"/></Button>
   </Grid>
   <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
    <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButtonStyle}" Click="CaptionMinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" ToolTip="Minimize"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE921;"/></Button>
    <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButtonStyle}" Click="CaptionMaximizeClick" AutomationProperties.Name="Maximize" ToolTip="Maximize"><TextBlock x:Name="CaptionMaximizeGlyph" FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE922;"/></Button>
    <Button x:Name="CaptionClose" Tag="Close" Style="{StaticResource CaptionButtonStyle}" Click="CaptionCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" ToolTip="Close"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE8BB;"/></Button>
   </StackPanel>
  </Grid>
  <!-- A source map's command bar: its scope, file commands, LOD and difficulty, then the viewport's commands in labelled groups. -->
  <DockPanel x:Name="SourceCommandBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="10,0,10,4" MinHeight="46" AutomationProperties.Name="Editor commands">

   <WrapPanel x:Name="SourceCommandItems" VerticalAlignment="Center">
    <ContentControl x:Name="SourceScopeHost" VerticalAlignment="Center" Margin="0,3" Focusable="False"/>
    <Border Style="{StaticResource CommandSeparator}"/>
    <StackPanel x:Name="SourceFileCommands" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3"/>
    <Border Style="{StaticResource CommandSeparator}"/>
    <StackPanel x:Name="SourcePickers" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,3,3"/>
    <Border x:Name="SourceCameraGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Camera"><StackPanel Orientation="Horizontal"><TextBlock Text="Camera" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceCameraItems" Orientation="Horizontal"/></StackPanel></Border>
    <Border x:Name="SourceDisplayGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Display"><StackPanel Orientation="Horizontal"><TextBlock Text="Display" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceDisplayItems" Orientation="Horizontal"/></StackPanel></Border>
    <Border x:Name="SourceOverlayGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Color overlays"><StackPanel Orientation="Horizontal"><TextBlock Text="Overlay" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceOverlayItems" Orientation="Horizontal"/></StackPanel></Border>
    <Border x:Name="SourceShowGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Show helpers"><StackPanel Orientation="Horizontal"><TextBlock Text="Show" Style="{StaticResource CommandGroupLabel}"/><StackPanel x:Name="SourceShowItems" Orientation="Horizontal"/></StackPanel></Border>
    <!-- Zones: the zone overlays, then the zone tool with its options after a divider. -->
    <Border x:Name="SourceZonesGroup" Style="{StaticResource CommandGroup}" AutomationProperties.Name="Zones"><StackPanel Orientation="Horizontal"><TextBlock Text="Zones" Style="{StaticResource CommandGroupLabel}"/>
     <StackPanel x:Name="SourceZoneOverlayItems" Orientation="Horizontal"/>
     <ToggleButton x:Name="PolygonZoneToolButton" Style="{StaticResource CommandToggle}" Click="PolygonZoneToolClick" AutomationProperties.Name="Edit zones" ToolTip="Edit zones — paint or erase a polygon zone on the polygons you drag over (P)"><local:PreviewIcon Kind="ZoneTool" Width="16" Height="16"/></ToggleButton>
     <StackPanel x:Name="ZoneToolOptions" Orientation="Horizontal" Visibility="Collapsed">
      <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
      <Border CornerRadius="5" Padding="2" BorderThickness="1" Background="#38000000" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" AutomationProperties.Name="Paint or erase"><StackPanel Orientation="Horizontal">
       <RadioButton x:Name="ZonePaintMode" GroupName="ZoneMode" Style="{StaticResource ZoneSegment}" IsChecked="True" Checked="ZoneModeChecked" AutomationProperties.Name="Paint" ToolTip="Paint — add the zone to each polygon (P)"><StackPanel Orientation="Horizontal"><local:PreviewIcon Kind="Brush" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Paint" VerticalAlignment="Center"/></StackPanel></RadioButton>
       <RadioButton x:Name="ZoneEraseMode" GroupName="ZoneMode" Style="{StaticResource ZoneSegment}" Checked="ZoneModeChecked" AutomationProperties.Name="Erase" ToolTip="Erase — remove the zone from each polygon (E)"><StackPanel Orientation="Horizontal"><local:PreviewIcon Kind="Eraser" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Erase" VerticalAlignment="Center"/></StackPanel></RadioButton>
      </StackPanel></Border>
      <Button x:Name="ZonePickerButton" Style="{StaticResource CommandButton}" Width="NaN" Height="28" MaxWidth="230" Padding="8,0" Margin="6,0,2,0" Click="ZonePickerClick" AutomationProperties.Name="Zone to paint or erase" ToolTip="Zone to paint or erase ([ and ] step through used zones)">
       <StackPanel Orientation="Horizontal"><Border x:Name="ZonePickerSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#47FFFFFF"/><TextBlock x:Name="ZonePickerName" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="ZonePickerLabel" FontSize="12" MaxWidth="110" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><local:PreviewIcon Kind="Chevron" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.65"/></StackPanel>
      </Button>
      <Popup x:Name="ZonePickerPopup" PlacementTarget="{Binding ElementName=ZonePickerButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"/>
     </StackPanel>
    </StackPanel></Border>
   </WrapPanel>
  </DockPanel>
  <StatusBar x:Name="PresentationStatusBar" DockPanel.Dock="Bottom" Padding="0" MinHeight="0"><StatusBarItem Padding="4,0" MinHeight="0" HorizontalContentAlignment="Stretch" Width="{Binding ActualWidth,ElementName=Shell}"><DockPanel LastChildFill="True"><StackPanel x:Name="PaneButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding HasRoot,Converter={StaticResource BoolVisibility}}"><Button x:Name="NavigatorPaneButton" Padding="6,1" Margin="2,0" Content="Navigator" Tag="Layout" Click="NavigatorButtonClick"/><Button x:Name="InspectorPaneButton" Padding="6,1" Margin="2,0" Content="Inspector" Tag="Layout" Click="InspectorButtonClick"/><Button x:Name="ToolsPaneButton" Padding="6,1" Margin="2,0" Content="Tools" Tag="Layout" Click="ToolsButtonClick"/></StackPanel><StackPanel x:Name="SourceStatusRight" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
     <Button x:Name="StatusNotices" Style="{StaticResource CommandButton}" Width="NaN" Height="24" Padding="8,0" Visibility="Collapsed" Click="PreviewNoticesClick" AutomationProperties.Name="Preview notices" ToolTip="Show the preview notices in Problems">
      <StackPanel Orientation="Horizontal"><local:PreviewIcon Kind="Warning" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource SystemFillColorCautionBrush}"/><TextBlock Text="Preview notices" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <Border CornerRadius="8" MinWidth="18" Height="16" Padding="5,0" VerticalAlignment="Center" Background="{DynamicResource SystemFillColorCautionBrush}"><TextBlock x:Name="StatusNoticeCount" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
     </Button>
     <Border Width="1" Height="14" Margin="4,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <ToggleButton x:Name="OutlinerPaneToggle" Style="{StaticResource StatusPaneToggle}" Content="World tree" Tag="outliner" Click="SourcePaneClick" AutomationProperties.Name="World tree" ToolTip="Show or hide the World tree"/>
     <ToggleButton x:Name="PropertiesPaneToggle" Style="{StaticResource StatusPaneToggle}" Content="Properties" Tag="properties" Click="SourcePaneClick" AutomationProperties.Name="Properties pane" ToolTip="Show or hide the Properties pane"/>
     <ToggleButton x:Name="ToolsPaneToggle" Style="{StaticResource StatusPaneToggle}" Content="Diagnostics" Tag="tools" Click="SourcePaneClick" AutomationProperties.Name="Diagnostics pane" ToolTip="Show or hide Diagnostics: the file and preview problems"/>
    </StackPanel>
    <!-- Docked right after SourceStatusRight, so it sits directly left of Preview notices in a source map and shows without one too. -->
    <Button x:Name="StatusUpdate" DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Width="NaN" Height="24" Padding="8,0" Margin="0,0,2,0" Visibility="Collapsed" Click="UpdateStatusClick" AutomationProperties.Name="Update available">
     <StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusUpdateIcon" FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE896;" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="StatusUpdateText" Text="Update available" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Border x:Name="StatusUpdateVersion" CornerRadius="8" MinWidth="18" Height="16" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}"><TextBlock x:Name="StatusUpdateVersionText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
    </Button>
    <StackPanel x:Name="SourceStatusLeft" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
     <local:PreviewIcon Kind="Pointer" Width="13" Height="13" Margin="8,0,6,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
     <TextBlock x:Name="StatusSelection" Text="No selection" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <TextBlock x:Name="StatusMission" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
     <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <StackPanel x:Name="StatusPlayerTankGroup" Orientation="Horizontal" Visibility="Collapsed" ToolTip="Preview only, not saved. Select the player tank to change it." ToolTipService.InitialShowDelay="0">
      <TextBlock x:Name="StatusPlayerTank" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
      <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     </StackPanel>
     <TextBlock x:Name="StatusCounts" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
     <Border Width="1" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></StatusBarItem></StatusBar>
  <Grid x:Name="Workbench" SizeChanged="WorkbenchSizeChanged" Margin="6,0,6,4">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilesColumn" Width="294"/><ColumnDefinition x:Name="NavigatorSplitterColumn" Width="6"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition x:Name="PropertiesSplitterColumn" Width="6"/><ColumnDefinition x:Name="PropertiesColumn" Width="352"/></Grid.ColumnDefinitions>
   <Grid x:Name="NavigatorHost">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="DetachedFilesColumn" Width="0"/><ColumnDefinition x:Name="FilesSplitterColumn" Width="0"/><ColumnDefinition x:Name="NavigatorContentColumn" Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
    <TabControl x:Name="DetachedFilesHost" Visibility="Collapsed"><TabItem Header="Files" IsSelected="True"><ContentControl x:Name="DetachedFilesContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem></TabControl>
    <GridSplitter x:Name="FilesSplitter" Grid.Column="1" Width="6" Visibility="Collapsed" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="WorkspaceSplitterCompleted" AutomationProperties.Name="Resize Files"/>
    <TabControl x:Name="NavigationTabs" Grid.Column="2" SelectionChanged="NavigatorSelectionChanged">
     <TabItem x:Name="FilesTab" Header="Files"><TreeView x:Name="FileTree" ItemsSource="{Binding Folders}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="FileDoubleClick" KeyDown="FileTreeKeyDown"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.ItemContainerStyle></TreeView></TabItem>
     <TabItem x:Name="AssetsTab" Header="Assets" Visibility="Collapsed"><Grid DataContext="{Binding SelectedDocument}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="4"><TextBox x:Name="AssetFilter" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter this file by name or record ID" AutomationProperties.Name="Filter this file by name or ID"/><TextBlock Text="Filter this file by name or ID…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=AssetFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <ComboBox Grid.Row="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindFilter}" Margin="4" AutomationProperties.Name="Asset type filter"/>
      <Grid Grid.Row="2"><DataGrid Background="Transparent" RowBackground="Transparent" x:Name="AssetGrid" PreviewMouseRightButtonDown="AssetContextTarget" ItemsSource="{Binding FilteredAssets}" SelectedItem="{Binding SelectedAsset,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" MinRowHeight="28" ColumnHeaderHeight="28" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" LoadingRow="AssetLoadingRow" SelectionChanged="AssetSelectionChanged" BorderThickness="0" GridLinesVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <DataGrid.ContextMenu><ContextMenu Opened="AssetContextOpening"><MenuItem x:Name="AssetPropertiesMenu" Header="Properties…" InputGestureText="Alt+Enter" Click="AssetPropertiesClick"/><Separator/><MenuItem Header="Export selected…" Click="ExportSelectedClick" /><MenuItem Header="Export selected as JSON…" Click="ExportJsonClick" /></ContextMenu></DataGrid.ContextMenu>
          <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="MinHeight" Value="56"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Animation"><Setter Property="MinHeight" Value="30"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTemplateColumn Width="*" Header="Name" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
           <Grid x:Name="AssetRow" Margin="4"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Animation"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#16808080" CornerRadius="4" Width="44" Height="44"><Grid><TextBlock x:Name="AssetPlaceholder" Text="▧" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Identity}" FontSize="12" /></StackPanel>
           </Grid>
           <Grid Visibility="Collapsed" x:Name="AnimationAssetRow" Margin="5,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="Animation"><Setter TargetName="AnimationAssetRow" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Texture"><Setter TargetName="AssetPlaceholder" Property="Visibility" Value="Collapsed" /></DataTrigger></DataTemplate.Triggers>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ID" Binding="{Binding Index}" Width="46" Visibility="Collapsed"/><DataGridTextColumn Header="Sequences" Binding="{Binding SequenceCount}" Width="SizeToHeader" MinWidth="92" Visibility="Collapsed"/></DataGrid.Columns>
         </DataGrid>
         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=AssetGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="No assets match these filters." TextWrapping="Wrap"/><Button Content="Clear filters" Click="ClearAssetFilterClick"/></StackPanel>
