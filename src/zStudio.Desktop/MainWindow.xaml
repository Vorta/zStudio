          <StackPanel Orientation="Horizontal"><TextBlock x:Name="ViewModeLabel" Text="Perspective" FontSize="12" VerticalAlignment="Center"/><local:PreviewIcon Kind="Chevron" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.65"/></StackPanel>
         </Button>
        </local:ViewportChip>
        <local:ViewportChip x:Name="AiChip" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,56,10,10">
         <StackPanel Orientation="Horizontal"><local:PreviewIcon Kind="AiNodes" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" TextElement.Foreground="#C9A2FF"/><TextBlock x:Name="AiChipText" VerticalAlignment="Center"/><TextBlock x:Name="AiChipMode" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel>
        </local:ViewportChip>
        <local:ViewportChip x:Name="FlyBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" MinHeight="36" Padding="12,0,4,0" FontSize="13" AutomationProperties.Name="Flycam" AutomationProperties.LiveSetting="Polite">
         <StackPanel Orientation="Horizontal">
          <local:PreviewIcon Kind="Fly" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
          <TextBlock Text="Flycam" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="Press" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
          <Border BorderThickness="1,1,1,2" CornerRadius="4" MinWidth="26" Height="20" Padding="5,0" Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"><TextBlock Text="Esc" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="to return to normal controls" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
          <TextBlock x:Name="FlyBannerSpeed" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
          <Button Content="Exit" Height="28" Padding="12,0" Margin="0,0,0,0" VerticalAlignment="Center" Click="FlyExitClick" AutomationProperties.Name="Exit Flycam"/>
         </StackPanel>
        </local:ViewportChip>
        <Border x:Name="FlyFrame" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Border x:Name="AiLabel" Panel.ZIndex="9" Visibility="Collapsed" IsHitTestVisible="False" Background="#E020252C" CornerRadius="5" Padding="10,6" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="460"><TextBlock x:Name="AiLabelText" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/></Border>
        </Grid><ContentControl x:Name="AnimationHost" Visibility="Collapsed" />
        <Grid x:Name="AudioPanel" Visibility="Collapsed" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="180" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock x:Name="AudioDetails" Margin="0,15" TextWrapping="Wrap" /><ns2:WaveformView x:Name="Waveform" Grid.Row="1" /><Slider x:Name="AudioSeek" Grid.Row="2" Minimum="0" ValueChanged="AudioSeekChanged" /><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10"><Button x:Name="AudioPlayButton" Content="Play" AutomationProperties.Name="Play audio" Click="PlayAudioClick" /><Button Content="Stop" Click="StopAudioClick" /><TextBlock x:Name="AudioTime" VerticalAlignment="Center" Margin="15,0" /></StackPanel><ListBox x:Name="AudioCues" Grid.Row="4" MaxHeight="220" VerticalAlignment="Top" MouseDoubleClick="CueDoubleClick" /></Grid>
        <TabControl x:Name="StructuredPanel" Visibility="Collapsed"><TabItem Header="Data"><TreeView x:Name="CentralTree"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle></TreeView></TabItem><TabItem Header="Text"><TextBox x:Name="ContentText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></TabItem><TabItem Header="Sequence events" x:Name="EventsTab" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DataGrid Background="Transparent" RowBackground="Transparent" x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="EventSelected" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="*" /><DataGridTextColumn Header="Event" Binding="{Binding Type}" Width="*" /><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*" /><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="90" /></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Margin="8" Text="Thresholds describe engine scheduling; this view does not simulate playback." TextWrapping="Wrap" Opacity="0.65" /></Grid></TabItem></TabControl>
       </Grid>
       <DockPanel x:Name="PreviewFooter" Grid.Row="3"><Button x:Name="PreviewNotices" DockPanel.Dock="Right" Visibility="Collapsed" Click="PreviewNoticesClick"/><TextBlock x:Name="PreviewInfo" FontSize="11" Opacity="0.65" Margin="8,5" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" /></DockPanel>
      </Grid>
      </Grid>
    </Grid>
    <GridSplitter x:Name="ToolsSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" DragCompleted="WorkspaceSplitterCompleted" AutomationProperties.Name="Resize bottom tools"/>
    <DockPanel x:Name="BottomTools" Grid.Row="2">
     <StackPanel x:Name="ToolsButtons" DockPanel.Dock="Right" Orientation="Vertical"><Button Content="↕" Tag="Layout" Click="MaximizeToolsClick" ToolTip="Maximize / restore tools" AutomationProperties.Name="Maximize or restore bottom tools"/><Button Content="×" Tag="Layout" Click="ToolsButtonClick" ToolTip="Hide tools" AutomationProperties.Name="Hide bottom tools"/></StackPanel>
     <!-- A source map shows only the problems (moved into SourceDiagnosticsHost), without tabs. -->
     <Grid><ContentControl x:Name="SourceDiagnosticsHost" Visibility="Collapsed" Focusable="False"/>
     <TabControl x:Name="ToolTabs" SelectionChanged="ToolSelectionChanged">
      <TabItem Header="Dispatch" x:Name="DispatchTab"><ContentControl x:Name="DispatchHost"/></TabItem>
      <TabItem Header="Event log" x:Name="EventLogTab"><ContentControl x:Name="EventLogHost"/></TabItem>
      <TabItem Header="Problems"><Grid x:Name="ProblemsPage"><ContentControl x:Name="ProblemsHost"/><Expander x:Name="DiagnosticsExpander" IsExpanded="True"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="File and preview notices" VerticalAlignment="Center"/><Button x:Name="FileProblemDetailsButton" Content="Details…" Click="FileProblemDetailsClick" IsEnabled="False" Margin="10,0,0,0"/></StackPanel></Expander.Header><DockPanel><DataGrid x:Name="FileProblems" SelectionChanged="FileProblemSelectionChanged" ItemsSource="{Binding Problems}" Background="Transparent" RowBackground="Transparent" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" MouseDoubleClick="FileProblemDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="SizeToHeader" MinWidth="100"/><DataGridTextColumn Header="Source" Binding="{Binding Scope}" Width="140"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle></DataGrid></DockPanel></Expander></Grid></TabItem>
      <TabItem Header="Runtime" x:Name="RuntimeTab"><ContentControl x:Name="RuntimeHost"/></TabItem>
      <TabItem Header="Related" ToolTip="Name-based matches; not a complete dependency graph"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="RelatedLimit" Text="Limited name-based matches: reference, index or result limits were reached. Use Search to find other assets." Margin="12,8" TextWrapping="Wrap" Visibility="Collapsed"/><ListBox Grid.Row="1" x:Name="RelatedList" Background="Transparent" BorderThickness="0" MouseDoubleClick="RelatedDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /><TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.6" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" Text="No name-based matches for this asset." Margin="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=RelatedList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></TabItem>
      <TabItem Header="Bytes"><TextBox x:Name="RawText" Background="Transparent" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" /></TabItem>
     </TabControl></Grid>
    </DockPanel>
<StackPanel Grid.RowSpan="3" x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700" Margin="30"><TextBlock x:Name="WelcomeTitle" Text="Explore Recoil’s assets" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="WelcomeDescription" Text="Textures, worlds, models, audio, scripts, and animation sequences — together in one workspace." FontSize="16" Opacity="0.65" Margin="0,16,0,26" TextWrapping="Wrap" />
     <Grid x:Name="WelcomeChoices" Margin="0,0,0,16">
      <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.Name="Work with source project">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Work with source project" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="Unpack the original game files once into RECOIL's source tree, edit the sources and export new game files." Opacity="0.65" Margin="0,8,0,18" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
         <Button x:Name="WelcomeInitializeProject" Content="Initialize" Click="WelcomeInitializeClick" Padding="18,8" Margin="0,0,8,0" AutomationProperties.Name="Initialize a source project" ToolTip="Unpack the retail ZBD files into a new source project and open it"/>
         <Button x:Name="WelcomeOpenProject" Content="Open" Click="WelcomeOpenProjectClick" Padding="18,8" AutomationProperties.Name="Open a source project" ToolTip="Open a source project folder (one with data and gamegen)"/>
        </StackPanel>
       </Grid>
      </Border>
     </Grid>
     <TextBlock x:Name="WelcomeHelp" Text="You can also drop a ZBD folder or file here." Opacity="0.55" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>

    <ScrollViewer x:Name="SourceMapPicker" Grid.RowSpan="3" Visibility="Collapsed" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900" Margin="32">
     <TextBlock x:Name="SourceMapLoading" Text="Loading..." FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     <StackPanel x:Name="SourceMapPickerContent">
      <TextBlock Text="Open a map" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
      <TextBlock x:Name="SourceMapPickerMessage" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16"/>
      <StackPanel x:Name="SourceMapButtons" HorizontalAlignment="Center"/>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </Grid>
   <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" DragCompleted="WorkspaceSplitterCompleted" AutomationProperties.Name="Resize Inspector"/>
   <Border x:Name="SourceOutlinerPane" Grid.Column="0" Style="{StaticResource SourcePane}" Visibility="Collapsed" AutomationProperties.Name="World tree">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="14,8,8,4">
      <Button x:Name="OutlinerNewGroup" DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Width="30" Height="30" IsEnabled="False" ToolTip="New group · creating groups is not available yet" AutomationProperties.Name="New group"><local:PreviewIcon Kind="NewGroup"/></Button>
      <Button DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Width="30" Height="30" Click="OutlinerCollapseAllClick" ToolTip="Collapse all" AutomationProperties.Name="Collapse all"><local:PreviewIcon Kind="CollapseAll"/></Button>
      <Button x:Name="OutlinerShowAll" DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Width="30" Height="30" Click="ShowAllClick" ToolTip="Show all · show every hidden object and end isolation" AutomationProperties.Name="Show all"><local:PreviewIcon Kind="Eye"/></Button>
      <!-- What the outliner's icons mean: a legend that opens from the info button. -->
      <ToggleButton x:Name="OutlinerLegendButton" DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Width="30" Height="30" ToolTip="What the icons mean" AutomationProperties.Name="Icon legend"
                    IsChecked="{Binding IsOpen,ElementName=OutlinerLegend,Mode=TwoWay}" IsHitTestVisible="{Binding IsOpen,ElementName=OutlinerLegend,Converter={StaticResource InverseBool}}"><local:PreviewIcon Kind="Info"/></ToggleButton>
      <Popup x:Name="OutlinerLegend" PlacementTarget="{Binding ElementName=OutlinerLegendButton}" Placement="Bottom" HorizontalOffset="-200" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
       <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10,16,12" MinWidth="230" AutomationProperties.Name="Icon legend">
        <StackPanel TextElement.FontSize="12">
         <TextBlock Text="Icons" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="World" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><TextBlock Text="World"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Folder" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#E8C26B"/><TextBlock Text="Groups (including level of detail)"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Geometry" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#7FB8E8"/><TextBlock Text="Geometry"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Cube" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="{DynamicResource AccentFillColorDefaultBrush}"/><TextBlock Text="Objects (placed models)"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Node" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#C9A2FF"/><TextBlock Text="Other nodes (lights, cameras…)"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Tank" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#E8907F"/><TextBlock Text="AI vehicles list (aiv)"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Pickup" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#8FD18B"/><TextBlock Text="Pickups list (puppies)"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Animation" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#6FC8D6"/><TextBlock Text="Map animations list (anim)"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Animated" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="#6FC8D6"/><TextBlock Text="Bound to mission animations"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="FrameSelection" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="Select it and frame it in the view"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,3"><local:PreviewIcon Kind="Eye" Width="15" Height="15" Margin="0,0,10,0" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="Hide or show in the view (no source edit)"/></StackPanel>
        </StackPanel>
       </Border>
      </Popup>
      <TextBlock Text="World" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <Grid DockPanel.Dock="Top" Margin="10,2,10,8">
      <TextBox x:Name="OutlinerSearch" TextChanged="OutlinerSearchChanged" MaxLength="256" Padding="10,5,32,5" AutomationProperties.Name="Search nodes"/>
      <TextBlock x:Name="OutlinerSearchHint" Text="Search" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
      <local:PreviewIcon x:Name="OutlinerSearchIcon" Kind="Search" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     </Grid>
     <Grid>
      <ContentControl x:Name="SourceTreeHost" Margin="6,0,6,8" Focusable="False"/>
      <ListBox x:Name="OutlinerResults" Visibility="Collapsed" Margin="6,0,6,8" Background="Transparent" BorderThickness="0" SelectionChanged="OutlinerResultSelected" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Matching nodes">
       <ListBox.ItemTemplate><DataTemplate>
        <DockPanel x:Name="MatchRow" Height="28" ToolTip="{Binding Row.ToolTip}" Background="Transparent" Margin="0,0,10,0">
         <Button x:Name="MatchEye" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Visibility="Hidden" Click="OutlinerEyeClick" Tag="{Binding Row}" ToolTip="{Binding Row.EyeToolTip}" AutomationProperties.Name="{Binding Row.EyeToolTip}"><local:PreviewIcon Kind="{Binding Row.EyeIcon}" Width="14" Height="14"/></Button>
         <Button x:Name="MatchFrame" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Visibility="Hidden" Click="OutlinerFrameClick" Tag="{Binding Row}" ToolTip="Frame selection" AutomationProperties.Name="Frame selection"><local:PreviewIcon Kind="FrameSelection" Width="14" Height="14"/></Button>
         <TextBlock DockPanel.Dock="Right" Text="{Binding Row.Meta}" FontSize="11" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
         <local:PreviewIcon Kind="{Binding Row.OutlinerIcon}" TextElement.Foreground="{Binding Row.OutlinerBrush}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding Row.OutlinerLabel}" FontSize="13" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
         <local:PreviewIcon Kind="Animated" Visibility="{Binding Row.IsAnimated,Converter={StaticResource BoolVisibility}}" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" TextElement.Foreground="#6FC8D6"/>
         <TextBlock Text="{Binding Path}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </DockPanel>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding IsMouseOver,ElementName=MatchRow}" Value="True"><Setter TargetName="MatchEye" Property="Visibility" Value="Visible"/><Setter TargetName="MatchFrame" Property="Visibility" Value="Visible"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.IsSelected}" Value="True"><Setter TargetName="MatchEye" Property="Visibility" Value="Visible"/><Setter TargetName="MatchFrame" Property="Visibility" Value="Visible"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.IsHidden}" Value="True"><Setter TargetName="MatchEye" Property="Visibility" Value="Visible"/><Setter TargetName="MatchRow" Property="Opacity" Value="0.55"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.CanHide}" Value="False"><Setter TargetName="MatchEye" Property="Visibility" Value="Collapsed"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.CanFrame}" Value="False"><Setter TargetName="MatchFrame" Property="Visibility" Value="Collapsed"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="OutlinerEmpty" Visibility="Collapsed" Text="No nodes match this search" Margin="16,12" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     </Grid>
    </DockPanel>
   </Border>
   <Border x:Name="SourcePropertiesPane" Grid.Column="4" Style="{StaticResource SourcePane}" Visibility="Collapsed" AutomationProperties.Name="Properties"><ContentControl x:Name="SourcePropertiesHost" Focusable="False"/></Border>
   <Grid x:Name="InspectorHost" Grid.Column="4" Visibility="Collapsed">
   <TabControl x:Name="InspectorTabs" Background="{DynamicResource TabViewItemHeaderBackgroundSelected}" SelectionChanged="InspectorSelectionChanged">
    <TabItem x:Name="ProgramTab" Header="Sequences" ToolTip="Animation sequences and their ordered events" Visibility="Collapsed"><ContentControl x:Name="ProgramHost"/></TabItem>
    <TabItem x:Name="PreviewSetupTab" Header="Settings" Visibility="Collapsed"><ContentControl x:Name="PreviewSetupHost"/></TabItem>
    <TabItem x:Name="ReferencesTab" Header="References" Visibility="Collapsed"><ContentControl x:Name="ReferencesHost"/></TabItem>
   </TabControl>
   </Grid>
  </Grid>
 </DockPanel>
 </Grid>
</Window>
