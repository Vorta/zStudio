       <ListBox.ItemTemplate><DataTemplate>
        <DockPanel x:Name="MatchRow" Height="28" ToolTip="{Binding Row.ToolTip}" Background="Transparent" Margin="0,0,4,0">
         <Button x:Name="MatchEye" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Click="OutlinerEyeClick" Tag="{Binding Row}" ToolTip="{Binding Row.EyeToolTip}" AutomationProperties.Name="{Binding Row.EyeToolTip}"><local:PreviewIcon Kind="{Binding Row.EyeIcon}" Width="14" Height="14"/></Button>
         <Button x:Name="MatchFrame" DockPanel.Dock="Right" Style="{StaticResource OutlinerEye}" Click="OutlinerFrameClick" Tag="{Binding Row}" ToolTip="Frame selection" AutomationProperties.Name="Frame selection"><local:PreviewIcon Kind="FrameSelection" Width="14" Height="14"/></Button>
         <TextBlock DockPanel.Dock="Right" Text="{Binding Row.Meta}" FontSize="11" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
         <Grid x:Name="MatchIconBox" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
          <local:PreviewIcon x:Name="MatchIcon" Kind="{Binding Row.OutlinerIcon}" TextElement.Foreground="{Binding Row.OutlinerBrush}"/>
          <Image x:Name="MatchPickupIcon" Visibility="Collapsed" Source="{Binding Row.PickupImage}" Stretch="Uniform" HorizontalAlignment="Right" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding Row.PickupPictureToolTip}"/>
          <Border x:Name="MatchSwatch" Visibility="Collapsed" Width="12" Height="12" CornerRadius="3" BorderThickness="1" BorderBrush="#47FFFFFF" Background="{Binding Row.Swatch}"/>
         </Grid>
         <TextBlock FontSize="13" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"><Run Text="{Binding Row.OutlinerLabel,Mode=OneWay}"/><Run Text="{Binding Row.SecondaryRunText,Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
         <TextBlock Text="{Binding Row.PickupNumberText}" Visibility="{Binding Row.HasPickupNumber,Converter={StaticResource BoolVisibility}}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular"/>
         <local:PreviewIcon Kind="Animated" Visibility="{Binding Row.IsAnimated,Converter={StaticResource BoolVisibility}}" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{Binding Row.AnimationBrush}" ToolTip="{Binding Row.AnimationsToolTip}"/>
         <TextBlock Text="{Binding Path}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </DockPanel>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding Row.IsHidden}" Value="True"><Setter TargetName="MatchEye" Property="Visibility" Value="Visible"/><Setter TargetName="MatchRow" Property="Opacity" Value="0.55"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.CanHide}" Value="False"><Setter TargetName="MatchEye" Property="Visibility" Value="Collapsed"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.CanFrame}" Value="False"><Setter TargetName="MatchFrame" Property="Visibility" Value="Collapsed"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.HasSwatch}" Value="True"><Setter TargetName="MatchIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="MatchSwatch" Property="Visibility" Value="Visible"/></DataTrigger>
         <DataTrigger Binding="{Binding Row.HasPickupIcon}" Value="True"><Setter TargetName="MatchIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="MatchPickupIcon" Property="Visibility" Value="Visible"/><Setter TargetName="MatchIconBox" Property="Width" Value="32"/><Setter TargetName="MatchIconBox" Property="Height" Value="20"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="OutlinerEmpty" Visibility="Collapsed" Text="Nothing matches this search" Margin="16,12" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     </Grid>
    </DockPanel>
   </Border>
   <Border x:Name="SourcePropertiesPane" Grid.Column="4" Style="{StaticResource SourcePane}" Visibility="Collapsed" AutomationProperties.Name="Properties">
    <DockPanel>
     <!-- Animation mode's right pane: the selection's header (tile, name, kind, Frame, Close), then Inspector (its card) | Scenario. -->
     <Border x:Name="AnimationPaneHeader" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,12,8,4" AutomationProperties.Name="Selection">
      <DockPanel>
       <Button x:Name="AnimationPaneClose" DockPanel.Dock="Right" Style="{StaticResource CardCloseButton}" Click="AnimationPaneCloseClick" ToolTip="Clear the selection (Esc)" AutomationProperties.Name="Clear the selection"><local:PreviewIcon Kind="Close" Width="16" Height="16"/></Button>
       <Button x:Name="AnimationPaneFrame" DockPanel.Dock="Right" Style="{StaticResource CardCloseButton}" Click="AnimationPaneFrameClick" ToolTip="Frame the selection: the objects it names, or the bound objects" AutomationProperties.Name="Frame the selection"><local:PreviewIcon Kind="FrameSelection" Width="16" Height="16"/></Button>
       <Border x:Name="AnimationPaneTile" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="AnimationPaneTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="AnimationPaneSubtitle" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       </StackPanel>
      </DockPanel>
     </Border>
     <Border x:Name="AnimationPaneTabs" DockPanel.Dock="Top" Visibility="Collapsed" Padding="16,0,12,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal">
       <ToggleButton x:Name="AnimationInspectorTab" Style="{StaticResource PaneTab}" Content="Inspector" Tag="inspector" Click="AnimationPaneTabClick" AutomationProperties.Name="Inspector" ToolTip="The card of the selection"/>
       <ToggleButton x:Name="AnimationScenarioTab" Style="{StaticResource PaneTab}" Content="Scenario" Tag="scenario" Click="AnimationPaneTabClick" AutomationProperties.Name="Scenario" ToolTip="The map's animation scenario: starts, called animations, conditions, inputs and rules"/>
      </StackPanel>
     </Border>
     <Grid><ContentControl x:Name="SourcePropertiesHost" Focusable="False"/><ContentControl x:Name="AnimationScenarioHost" Visibility="Collapsed" Focusable="False"/></Grid>
    </DockPanel>
   </Border>
   <!-- A compiled animation's right pane: the selection's header, then Inspector | Scenario (built by MainWindow.CompiledAnimation). -->
   <Grid x:Name="InspectorHost" Grid.Column="4" Visibility="Collapsed"><ContentControl x:Name="CompiledPaneHost" Focusable="False"/></Grid>
  </Grid>
 </DockPanel>
 </Grid>
</Window>
