<Application x:Class="Recoil.Zbd.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Startup="OnStartup" ThemeMode="System">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PreviewStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Thickness x:Key="WorkspaceControlPadding">8,4,8,4</Thickness>
  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="{DynamicResource WorkspaceControlPadding}"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="Padding" Value="{DynamicResource WorkspaceControlPadding}"/></Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}"><Setter Property="MaxWidth" Value="500"/></Style>
  <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
   <DrawingBrush.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#23282F" Geometry="M0,0 H20 V20 H0Z"/>
    <GeometryDrawing Brush="#303740" Geometry="M0,0 H10 V10 H0Z M10,10 H20 V20 H10Z"/>
   </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
 </ResourceDictionary></Application.Resources>
</Application>
